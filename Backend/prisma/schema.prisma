generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photoKey     String?

  @@map("admin_users")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  country   String?
  logoKey   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageKey    String?
  parentId    String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]

  @@map("categories")
}

model Product {
  id             String       @id @default(cuid())
  reference      String       @unique
  name           String
  slug           String       @unique
  description    String?
  imageKeys      String[]
  sheetKey       String?
  costPrice      Float?
  basePrice      Float        @default(0)
  hasIva         Boolean      @default(true)
  ivaRate        Float        @default(14)
  hasIec         Boolean      @default(false)
  iecRate        Float        @default(0)
  salePrice      Float?
  trackStock     Boolean      @default(true)
  stock          Int          @default(0)
  stockAlert     Int          @default(5)
  categoryId     String?
  brandId        String?
  active         Boolean      @default(true)
  featured       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  linkedInBundle BundleItem[] @relation("BundleLinked")
  bundleItems    BundleItem[] @relation("BundleParent")
  brand          Brand?       @relation(fields: [brandId], references: [id])
  category       Category?    @relation(fields: [categoryId], references: [id])
  storeStocks    StoreStock[]
  orderItems     OrderItem[]

  @@map("products")
}

model BundleItem {
  id          String   @id @default(cuid())
  parentId    String
  linkedId    String?
  name        String
  price       Float
  discountPct Float    @default(0)
  sortOrder   Int      @default(0)
  linked      Product? @relation("BundleLinked", fields: [linkedId], references: [id])
  parent      Product  @relation("BundleParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@map("bundle_items")
}

model Store {
  id          String       @id @default(cuid())
  name        String
  address     String
  phone       String?
  lat         Float?
  lng         Float?
  active      Boolean      @default(true)
  // Ligação ao Winmax: terminais (POS) da loja e armazéns cujo stock lhe pertence
  winmaxTerminalCodes  Int[] @default([])
  winmaxWarehouseCodes Int[] @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  storeStocks StoreStock[]

  @@map("stores")
}

// ─── Winmax (ERP) — cópia sincronizada pelo conector ─────────────────────────
// Dados lidos dos web services do Winmax. Não são editados no admin: o
// conector reescreve-os a cada sincronização.

model WinmaxArticle {
  code                String        @id // ArticleCode no Winmax
  designation         String
  familyCode          String?
  subFamilyCode       String?
  subSubFamilyCode    String?
  subSubSubFamilyCode String?
  sellUnit            String?
  saftType            String?
  currency            String?
  priceWithTax        Float? // SalesPrice1WithTaxesFees
  priceWithoutTax     Float? // SalesPrice1WithoutTaxesFees
  costPrice           Float? // NetCostPrice
  stockTotal          Float         @default(0) // soma dos armazéns (0 = total no Winmax)
  imageUrl            String?
  lastSellDate        DateTime?
  lastPurchaseDate    DateTime?
  present             Boolean       @default(true) // false se deixou de vir na última sincronização completa
  syncedAt            DateTime      @default(now())
  // A API do Winmax não devolve o código de barras: vem de exportações do
  // Winmax (CSV) e não é tocado pela sincronização.
  barcode             String?
  stocks              WinmaxStock[]
  images              WinmaxArticleImage[]
  info                WinmaxArticleInfo?

  @@index([designation])
  @@map("winmax_articles")
}

// Fotos de um artigo, guardadas no R2 (CDN). position 0 = foto principal.
model WinmaxArticleImage {
  id          String        @id @default(cuid())
  articleCode String
  key         String // chave no R2
  source      String // icecat | winmax | upload
  sourceUrl   String?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  article     WinmaxArticle @relation(fields: [articleCode], references: [code], onDelete: Cascade)

  @@index([articleCode, position])
  @@map("winmax_article_images")
}

// Resultado da procura no catálogo Icecat (fotos, título, especificações).
model WinmaxArticleInfo {
  articleCode String        @id
  status      String // found | not_found | error
  matchedBy   String? // ean | model
  brand       String?
  mpn         String? // código do fabricante
  icecatId    Int?
  title       String?
  description String?
  specs       Json?
  error       String?
  lookedUpAt  DateTime      @default(now())
  article     WinmaxArticle @relation(fields: [articleCode], references: [code], onDelete: Cascade)

  @@map("winmax_article_info")
}

// Procura automática de fotos (uma de cada vez).
model WinmaxImageJob {
  id         String    @id @default(cuid())
  status     String    @default("running") // running | ok | error
  total      Int       @default(0)
  processed  Int       @default(0)
  found      Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("winmax_image_jobs")
}

model WinmaxStock {
  articleCode   String
  warehouseCode Int
  quantity      Float         @default(0)
  location      String?
  article       WinmaxArticle @relation(fields: [articleCode], references: [code], onDelete: Cascade)

  @@id([articleCode, warehouseCode])
  @@index([warehouseCode])
  @@map("winmax_stocks")
}

model WinmaxWarehouse {
  code      Int      @id
  name      String
  syncedAt  DateTime @default(now())

  @@map("winmax_warehouses")
}

model WinmaxTerminal {
  code      Int      @id
  name      String
  syncedAt  DateTime @default(now())

  @@map("winmax_terminals")
}

// Árvore de famílias (4 níveis). id = caminho de códigos, ex.: "1", "1.10", "1.10.1", "1.10.1.26"
model WinmaxFamily {
  id        String   @id
  level     Int
  code      String
  name      String
  parentId  String?
  syncedAt  DateTime @default(now())

  @@index([parentId])
  @@map("winmax_families")
}

model WinmaxSyncRun {
  id         String    @id @default(cuid())
  mode       String // full | incremental
  status     String    @default("running") // running | ok | error
  trigger    String    @default("schedule") // schedule | manual
  articles   Int       @default(0)
  pages      Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@map("winmax_sync_runs")
}

model StoreStock {
  id        String   @id @default(cuid())
  productId String
  storeId   String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@map("store_stocks")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("site_content")
}

model Customer {
  id           String     @id @default(cuid())
  name         String
  phone        String?
  email        String     @unique
  passwordHash String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[]
  orders       Order[]

  @@map("customers")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("favorites")
}

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  status        String   @default("pending") // pending|confirmed|preparing|shipped|delivered|cancelled

  // Snapshot do cliente (funciona para convidado e cliente registado)
  customerId    String?
  customerName  String
  customerEmail String
  customerPhone String?

  // Entrega
  province      String?
  city          String?
  address       String?
  notes         String?

  // Pagamento (placeholder até integração)
  paymentMethod String? // multicaixa|transferencia|referencia|cartao
  paymentStatus String   @default("pending") // pending|paid|failed|refunded

  // Totais
  subtotal      Float    @default(0)
  shipping      Float    @default(0)
  total         Float    @default(0)

  items         OrderItem[]
  customer      Customer?   @relation(fields: [customerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  name           String
  reference      String?
  priceFormatted String?
  image          String?
  unitPrice      Float
  qty            Int
  lineTotal      Float
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}
