generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Utilizador do painel (acesso restrito)
model PanelUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("panel_users")
}

// Amostras de métricas do servidor (histórico p/ gráficos)
model Metric {
  id        BigInt   @id @default(autoincrement())
  ts        DateTime @default(now())
  cpu       Float // % uso CPU
  memUsed   Float // MB
  memTotal  Float // MB
  diskUsed  Float // GB
  diskTotal Float // GB
  netRx     Float // KB/s
  netTx     Float // KB/s
  load1     Float
  uptime    Float // segundos

  @@index([ts])
  @@map("metrics")
}

// Eventos de erro capturados (loja, admin, backend, pagamentos, etc.)
model ErrorEvent {
  id         String   @id @default(cuid())
  source     String // frontend|admin|backend|payment|system|panel
  level      String   @default("error") // error|warn|fatal
  message    String
  stack      String?
  url        String?
  meta       Json?
  emailed    Boolean  @default(false)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@map("error_events")
}

// Registo de deploys
model DeployLog {
  id        String   @id @default(cuid())
  apps      String
  commit    String?
  status    String   @default("running") // running|success|failed
  output    String?
  createdAt DateTime @default(now())

  @@map("deploy_logs")
}
