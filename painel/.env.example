# Painel VPS — variáveis de ambiente
NODE_ENV=production
PORT=3040

# Base de dados própria do painel
DATABASE_URL="postgresql://vercel100:PASS@127.0.0.1:5432/vercel_100?schema=public"

# Segredos
PANEL_JWT_SECRET="gerar-uma-frase-longa-aleatoria"
INGEST_TOKEN="token-partilhado-para-ingestao-de-erros"

# Alertas por email (Resend — já configurado no domínio)
ALERT_EMAIL="joasumbo@gmail.com"
ALERT_FROM="alertas@100bytes.co.ao"
RESEND_API_KEY=""   # <-- em falta

# Seed inicial (opcional; se PASSWORD vazia, é gerada e impressa)
PANEL_ADMIN_EMAIL="joasumbo@gmail.com"
PANEL_ADMIN_NAME="João Sumbo"
PANEL_ADMIN_PASSWORD=""
