<!DOCTYPE html>
<html lang="pt-AO">
    <head>
        <!-- Title -->
        <%- include('partials/_seo') %>

        <!-- Required Meta Tags Always Come First -->
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

        <!-- Favicon -->

        <!-- Google Fonts -->
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

        <!-- CSS Implementing Plugins -->
        <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
        <link rel="stylesheet" href="/assets/css/font-electro.css">

        <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
        <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
        <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
        <link rel="stylesheet" href="/assets/vendor/fancybox/jquery.fancybox.css">
        <link rel="stylesheet" href="/assets/vendor/slick-carousel/slick/slick.css">
        <link rel="stylesheet" href="/assets/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">

        <!-- CSS Electro Template -->
        <link rel="stylesheet" href="/assets/css/theme.css">

        <style>
            :root {
                --brand-primary: #F57C00;
                --brand-secondary: #D96A00;
            }

            .bg-primary,
            .badge-primary,
            .u-header .btn-primary,
            .u-header .btn-primary:not(:disabled):not(.disabled):active,
            .u-header .btn-primary:not(:disabled):not(.disabled).active {
                background-color: var(--brand-primary) !important;
                border-color: var(--brand-primary) !important;
            }

            .u-header-topbar {
                background-color: #ffffff !important;
                border-bottom: 1px solid #e6e6e6;
            }

            .btn-primary,
            .btn-primary:hover,
            .btn-primary:focus,
            .btn-primary:active,
            .btn-primary:not(:disabled):not(.disabled):active,
            .btn-primary:not(:disabled):not(.disabled).active {
                background-color: var(--brand-primary) !important;
                border-color: var(--brand-primary) !important;
            }

            .btn-primary:hover,
            .btn-primary:focus,
            .btn-add-cart:hover,
            a.text-primary:hover,
            a:hover .text-primary {
                background-color: var(--brand-secondary) !important;
                border-color: var(--brand-secondary) !important;
                color: #fff !important;
            }

            .text-primary,
            .link-hover__brand:hover,
            .u-header__nav-link:hover,
            .u-header-topbar__nav-link:hover,
            .ec.ec-add-to-cart,
            .ec.ec-favorites {
                color: var(--brand-primary) !important;
            }

            .border-primary,
            .border-color-1,
            .nav-tab .nav-link.active::before,
            .nav-tab .nav-link:hover::before {
                border-color: var(--brand-primary) !important;
            }

            .u-header-topbar .topbar-left a,
            .u-header-topbar .u-header-topbar__nav-link,
            .u-header-topbar .dropdown-nav-link,
            .u-header-topbar .text-gray-50 {
                color: #2f2f33 !important;
            }

            .u-header-topbar .topbar-left a,
            .u-header-topbar .u-header-topbar__nav-link {
                font-weight: 600;
            }

            .u-header-topbar .u-header-topbar__nav-link:hover,
            .u-header-topbar .dropdown-nav-link:hover,
            .u-header-topbar .topbar-left a:hover {
                color: #1f1f22 !important;
                opacity: 1;
            }

            .u-header-topbar .u-header-topbar__nav-item-border::after {
                border-color: rgba(47, 47, 51, 0.28) !important;
            }

            .u-header .form-control,
            .u-header .form-control::placeholder {
                color: #5f636b !important;
                font-weight: 600;
            }

            .bg-primary-down-lg {
                background-color: #ffffff !important;
            }

            .promo-tile {
                min-height: 132px;
            }

            .promo-tile .promo-copy {
                min-height: 112px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .promo-tile .promo-title {
                margin-bottom: 8px;
                line-height: 1.18;
            }

            .promo-tile .link {
                margin-top: auto;
            }

            .promo-tile .link__icon-inner {
                background-color: var(--brand-primary) !important;
                border-color: var(--brand-primary) !important;
                color: #ffffff !important;
            }

            .promo-tile .link__icon-inner i {
                color: #ffffff !important;
            }

            /* === Product card hover image swap === */
            .product-img-wrap {
                position: relative;
                display: block;
                overflow: hidden;
                height: 200px;
            }
            .product-img-wrap img {
                position: absolute;
                top: 0; left: 0;
                width: 100%;
                height: 100%;
                object-fit: contain;
                transition: opacity 0.35s ease;
            }
            .product-img-primary { opacity: 1; z-index: 1; }
            .product-img-hover  { opacity: 0; z-index: 2; }
            .product-img-wrap:hover .product-img-primary { opacity: 0; }
            .product-img-wrap:hover .product-img-hover  { opacity: 1; }

            /* === Product card equal height === */
            .products-group .product-item__body {
                display: flex;
                flex-direction: column;
            }
            .products-group .product-item__body .mb-2:has(.product-img-wrap) {
                flex: 1 1 auto;
            }
            .products-group .product-item__title {
                min-height: 42px;
            }
            /* Carrinho sempre visível */
            .prodcut-add-cart { display: block !important; }
            /* Ícone branco dentro do botão laranja */
            .btn-add-cart .ec { color: #fff !important; }
        </style>
        <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
        <link rel="stylesheet" href="/css/loja.css">
        <link rel="stylesheet" href="/css/listagem.css">
        <style>
            /* Topo da página inicial */
            .hh { max-width:1430px; margin:20px auto 36px; padding:0 15px; display:grid; grid-template-columns:minmax(0, 3fr) minmax(0, 1fr); gap:16px; }
            .hh-solo { grid-template-columns:1fr; }
            .hh-slider { position:relative; border-radius:18px; overflow:hidden; background:#f4f4f7; aspect-ratio:1893 / 650; }
            .hh-track { display:flex; height:100%; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; }
            .hh-track::-webkit-scrollbar { display:none; }
            .hh-slide { flex:0 0 100%; height:100%; scroll-snap-align:start; }
            .hh-slide img, .hh-link { display:block; width:100%; height:100%; }
            .hh-slide img { object-fit:cover; }
            .hh-seta { position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; border-radius:50%; border:0; background:rgba(255,255,255,.92); color:#1a1a2e; font-size:20px; display:flex; align-items:center; justify-content:center; cursor:pointer; opacity:0; transition:opacity .2s, background .15s; box-shadow:0 2px 10px rgba(0,0,0,.12); }
            .hh-ant { left:14px; } .hh-seg { right:14px; }
            .hh-slider:hover .hh-seta, .hh-seta:focus-visible { opacity:1; }
            .hh-seta:hover { background:#fff; }
            .hh-dots { position:absolute; left:50%; bottom:14px; transform:translateX(-50%); display:flex; gap:6px; padding:6px 8px; border-radius:999px; background:rgba(0,0,0,.25); backdrop-filter:blur(4px); }
            .hh-dot { width:8px; height:8px; border:0; padding:0; border-radius:999px; background:rgba(255,255,255,.55); cursor:pointer; overflow:hidden; transition:width .3s; }
            .hh-dot.on { width:34px; background:rgba(255,255,255,.4); }
            .hh-dot span { display:block; height:100%; width:0; background:#fff; border-radius:999px; }
            .hh-dot.on span { animation:hhProgresso var(--hh-tempo, 6s) linear forwards; }
            .hh-slider.pausa .hh-dot.on span { animation-play-state:paused; }
            @keyframes hhProgresso { from { width:0; } to { width:100%; } }
            /* A altura da linha vem só do banner: os cartões (height:0 + min-height:100%) não a aumentam, apenas a ocupam */
            .hh-cards { display:grid; grid-template-rows:1fr 1fr; gap:16px; height:0; min-height:100%; }
            .hh-card { container-type:size; }
            /* a foto ocupa só a altura do cartão (sem cortes) */
            .hh-card > .hh-card-img { height:100%; min-height:0; }
            .hh-card > .hh-card-img img { max-height:100%; max-width:100%; width:auto; height:auto; }
            /* Cartões baixos (ecrãs mais estreitos ou com skin): mais compactos */
            @container (max-height: 175px) {
                .hh-card .hh-card-txt { justify-content:center; }
                .hh-card .hh-card-nome { margin-top:4px; font-size:13px; }
                .hh-card .hh-card-preco { margin-top:6px; padding-top:0; font-size:16px; }
                .hh-card .hh-card-cta { display:none; }
            }
            @container (max-height: 125px) {
                .hh-card .hh-card-nome { -webkit-line-clamp:1; }
            }
            .hh-card { position:relative; display:flex; align-items:stretch; gap:10px; padding:16px; border-radius:18px; background:#f4f4f7; color:#1a1a2e !important; text-decoration:none !important; overflow:hidden; min-height:0; transition:background .2s; }
            .hh-card:hover { background:#eeeef2; }
            .hh-card-txt { display:flex; flex-direction:column; min-width:0; flex:1 1 55%; z-index:1; }
            .hh-tag { font-size:12px; font-weight:600; color:#E06F00; }
            .hh-card-nome { font-size:14px; font-weight:500; line-height:1.3; margin-top:8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
            .hh-card-preco { font-size:17px; font-weight:600; margin-top:auto; padding-top:6px; }
            .hh-card-cta { font-size:12px; font-weight:600; color:#E06F00; margin-top:4px; display:inline-flex; align-items:center; gap:6px; }
            .hh-card-cta i { font-size:10px; transition:transform .2s; }
            .hh-card:hover .hh-card-cta { color:#F57C00; }
            /* Um toque da cor da marca: brilho suave atrás do produto */
            .hh-card { background:radial-gradient(circle at 80% 50%, rgba(245,124,0,.13) 0, rgba(245,124,0,0) 130px), #f4f4f7; }
            .hh-card:hover { background:radial-gradient(circle at 80% 50%, rgba(245,124,0,.19) 0, rgba(245,124,0,0) 150px), #f0f0f4; }
            @media (max-width: 991.98px) { .hh-card, .hh-card:hover { background:radial-gradient(circle at 50% 30%, rgba(245,124,0,.13) 0, rgba(245,124,0,0) 90px), #f4f4f7; } }
            .hh-card:hover .hh-card-cta i { transform:translateX(3px); }
            .hh-card-img { flex:0 0 42%; display:flex; align-items:center; justify-content:center; min-width:0; }
            .hh-card-img img { max-width:100%; max-height:100%; object-fit:contain; mix-blend-mode:multiply; transition:transform .3s; }
            .hh-card:hover .hh-card-img img { transform:scale(1.05); }
            @media (max-width: 991.98px) {
                .hh { grid-template-columns:1fr; gap:12px; margin-top:12px; padding:0 12px; }
                .hh-slider { border-radius:14px; }
                .hh-cards { grid-template-rows:none; grid-template-columns:1fr 1fr; gap:12px; height:auto; min-height:0; }
                .hh-card { container-type:normal; }
                .hh-card > .hh-card-img { height:96px; }
                .hh-card { flex-direction:column-reverse; padding:12px; border-radius:14px; }
                .hh-card-img { flex:0 0 auto; height:96px; }
                .hh-card-nome { font-size:13px; }
                .hh-card-preco { font-size:15px; }
                .hh-dots { bottom:8px; }
                .hh-seta { display:none; }
            }
            /* Skin publicitário: duas laterais clicáveis, só em ecrãs largos */
            .sk { display:none; }
            @media (min-width: 1360px) {
                /* Largura de cada lateral: pelo menos 150px; em ecrãs grandes ocupa a margem que sobra */
                body:has(.sk) { --sk-w: max(150px, calc((100vw - 1460px) / 2)); --sk-in: min(var(--sk-w), 280px); }
                /* O conteúdo encolhe para dar lugar às laterais */
                body:has(.sk) .hh, body:has(.sk) .cx, body:has(.sk) .container { max-width:calc(100vw - 2 * var(--sk-w) - 24px); }
                .sk { display:block; }
                .sk-lado { position:fixed; top:64px; bottom:0; width:var(--sk-w); z-index:5; display:flex; flex-direction:column; align-items:center; text-align:center; padding:32px 16px; color:#fff !important; text-decoration:none !important; overflow:hidden; transition:opacity .3s, filter .2s;
                    background:radial-gradient(120% 60% at 50% 0%, #ff9a2e 0%, rgba(255,154,46,0) 60%), linear-gradient(180deg, #F57C00 0%, #d96a00 100%); }
                /* Em ecrãs muito largos o laranja enche a margem, mas o conteúdo fica numa coluna de 280px junto ao site */
                .sk-esq { left:0; padding-left:calc(var(--sk-w) - var(--sk-in) + 16px); }
                .sk-dir { right:0; padding-right:calc(var(--sk-w) - var(--sk-in) + 16px); }
                .sk-lado:hover { filter:brightness(1.05); }
                .sk-tag { font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; opacity:.85; }
                .sk-nome { font-size:clamp(17px, 1.25vw, 24px); font-weight:700; line-height:1.15; margin-top:12px; letter-spacing:-.01em; }
                .sk-foto { width:100%; max-width:210px; aspect-ratio:1; border-radius:50%; background:#fff; display:flex; align-items:center; justify-content:center; margin:32px 0 22px; box-shadow:0 20px 40px rgba(120,50,0,.25); }
                .sk-foto img { width:72%; height:72%; object-fit:contain; transition:transform .4s; }
                .sk-lado:hover .sk-foto img { transform:scale(1.06) rotate(-3deg); }
                .sk-marca { font-size:13px; font-weight:500; opacity:.9; }
                .sk-preco { font-size:clamp(20px, 1.55vw, 30px); font-weight:700; line-height:1.1; margin-top:14px; letter-spacing:-.02em; }
                .sk-antes { font-size:14px; text-decoration:line-through; opacity:.7; margin-top:4px; }
                .sk-sub { font-size:13px; opacity:.9; margin-top:14px; max-width:200px; line-height:1.4; }
                .sk-btn { margin-top:26px; display:inline-flex; align-items:center; gap:8px; height:40px; padding:0 16px; white-space:nowrap; font-size:13px !important; max-width:100%; border-radius:999px; background:#16161d; color:#fff; font-size:14px; font-weight:600; }
                .sk-btn i { font-size:11px; transition:transform .2s; }
                .sk-lado:hover .sk-btn i { transform:translateX(3px); }
                /* Pessoa encostada ao fundo da lateral, por baixo dos textos */
                .sk-lado > span { position:relative; z-index:1; }
                .sk-pessoa { position:absolute; bottom:0; transform:translateX(-50%); max-width:340px; height:auto; z-index:0; pointer-events:none; transition:transform .5s; filter:drop-shadow(0 -6px 24px rgba(120,50,0,.25)); }
                .sk-esq .sk-pessoa { left:calc(var(--sk-w) - var(--sk-in) / 2); width:calc(var(--sk-in) * 1.02); max-width:300px; }
                .sk-dir .sk-pessoa { left:calc(var(--sk-in) / 2); width:calc(var(--sk-in) * 1.12); }
                .sk-dir .sk-arvore { width:calc(var(--sk-in) * .92); max-width:260px; bottom:96px; filter:drop-shadow(0 10px 18px rgba(120,50,0,.3)); }
                .sk-lado:hover .sk-pessoa { transform:translateX(-50%) translateY(-6px); }
            }
            @media (min-width: 1360px) and (max-height: 760px) {
                .sk-pessoa { display:none; }
            }

            /* Oferta especial (ao lado dos separadores de produtos) */
            .of-card { display:flex; flex-direction:column; width:300px; position:sticky; top:88px; border-radius:20px; overflow:hidden; text-decoration:none !important; color:#1a1a2e !important;
                background:radial-gradient(circle at 50% 32%, rgba(245,124,0,.16) 0, rgba(245,124,0,0) 170px), #f4f4f7; transition:transform .25s, box-shadow .25s; }
            .of-card:hover { transform:translateY(-3px); box-shadow:0 14px 34px rgba(26,26,46,.10); }
            .of-topo { display:flex; justify-content:space-between; align-items:center; padding:18px 20px 0; }
            .of-tag { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#E06F00; }
            .of-tag::before { content:""; width:6px; height:6px; border-radius:50%; background:#F57C00; box-shadow:0 0 0 4px rgba(245,124,0,.18); }
            .of-desc { height:28px; padding:0 10px; border-radius:999px; background:#16161d; color:#fff; font-size:13px; font-weight:700; display:inline-flex; align-items:center; }
            .of-foto { height:230px; display:flex; align-items:center; justify-content:center; padding:18px 24px; }
            .of-foto img { max-width:100%; max-height:100%; object-fit:contain; mix-blend-mode:multiply; transition:transform .4s; }
            .of-card:hover .of-foto img { transform:scale(1.05); }
            .of-info { display:flex; flex-direction:column; gap:6px; margin:0 10px 10px; padding:16px; border-radius:14px; background:#fff; flex:1; }
            .of-cat { font-size:12px; color:#6b7280; }
            .of-nome { font-size:15px; font-weight:600; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
            .of-precos { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; margin-top:2px; }
            .of-precos b { font-size:22px; font-weight:700; letter-spacing:-.01em; }
            .of-precos s { font-size:13px; color:#a1a1aa; }
            .of-stock { margin-bottom:12px; display:flex; align-items:center; gap:6px; font-size:12px; color:#15803d; }
            .of-stock::before { content:""; width:6px; height:6px; border-radius:50%; background:#16a34a; }
            .of-btn { display:flex; align-items:center; justify-content:center; gap:8px; height:44px; margin-top:auto; border-radius:999px; background:#16161d; color:#fff; font-size:14px; font-weight:600; transition:background .2s; }
            .of-btn i { font-size:11px; transition:transform .2s; }
            .of-card:hover .of-btn { background:#F57C00; }
            .of-card:hover .of-btn i { transform:translateX(3px); }
            @media (max-width: 767.98px) { .of-card { width:100%; } }

            /* Explorar por categoria */
            .cx { max-width:1430px; margin:0 auto 36px; padding:0 15px; }
            .cx-topo { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; }
            .cx-titulo { font-size:20px; font-weight:600; color:#1a1a2e; margin:0; letter-spacing:-.01em; }
            .cx-grelha { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(10, minmax(0,1fr)); gap:22px 12px; }
            .cx-item { display:flex; flex-direction:column; align-items:center; gap:10px; text-decoration:none !important; color:#1a1a2e !important; }
            .cx-circulo { width:100%; max-width:112px; aspect-ratio:1; border-radius:50%; background:#f4f4f7; display:flex; align-items:center; justify-content:center; overflow:hidden; transition:background .2s; }
            .cx-circulo img { width:64%; height:64%; object-fit:contain; mix-blend-mode:multiply; transition:transform .3s; }
            .cx-item:hover .cx-circulo { background:#ececf1; }
            .cx-item:hover .cx-circulo img { transform:scale(1.07); }
            .cx-nome { font-size:13px; font-weight:500; line-height:1.3; text-align:center; max-width:120px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
            .cx-item:hover .cx-nome { color:#F57C00; }
            .cx-item:focus-visible { outline:none; }
            .cx-item:focus-visible .cx-circulo { box-shadow:0 0 0 2px #fff, 0 0 0 4px #F57C00; }
            @media (max-width: 1199.98px) { .cx-grelha { grid-template-columns:repeat(8, minmax(0,1fr)); } }
            @media (max-width: 991.98px) {
                .cx { padding:0 12px; margin-bottom:28px; }
                .cx-titulo { font-size:17px; }
                /* Telemóvel: duas linhas que deslizam na horizontal */
                .cx-grelha { grid-template-columns:none; grid-template-rows:repeat(2, auto); grid-auto-flow:column; grid-auto-columns:76px; gap:16px 12px; overflow-x:auto; scroll-snap-type:x proximity; scrollbar-width:none; margin:0 -12px; padding:0 12px 4px; }
                .cx-grelha::-webkit-scrollbar { display:none; }
                .cx-grelha li { scroll-snap-align:start; }
                .cx-circulo { width:76px; }
                .cx-nome { font-size:12px; }
            }
        </style>
</head>

    <body>

        <%- include('partials/_header-compacto') %>
        <% if (typeof skin !== "undefined" && skin) { var skUrl = "/" + (skin.categorySlug || "produto") + "/" + skin.urlKey; %>
        <div class="sk" id="skin" aria-label="Publicidade">
            <a class="sk-lado sk-esq" href="<%= skUrl %>" data-skin="esq">
                <span class="sk-tag">Novo stock</span>
                <span class="sk-nome"><%= skin.name %></span>
                <span class="sk-foto"><% if (skin.image) { %><img src="<%= skin.image %>" alt=""><% } %></span>
                <span class="sk-marca">Acabou de chegar à 100 bytes</span>
                <img class="sk-pessoa" src="/img/skin/pessoa-esq.webp" alt="" loading="lazy">
            </a>
            <a class="sk-lado sk-dir" href="<%= skUrl %>" data-skin="dir">
                <span class="sk-tag">Disponível já</span>
                <span class="sk-preco"><%= skin.salePrice || skin.basePrice %></span>
                <% if (skin.salePrice) { %><span class="sk-antes"><%= skin.basePrice %></span><% } %>
                <span class="sk-sub">Entrega em Luanda e envio para todo o país</span>
                <span class="sk-btn">Ver produto <i class="fas fa-arrow-right"></i></span>
                <img class="sk-pessoa sk-arvore" src="/img/skin/arvore-natal.svg" alt="" loading="lazy">
            </a>
        </div>
        <% } %>

        <!-- ========== MAIN CONTENT ========== -->
        <main id="content" role="main">
            <!-- Topo: slider + destaques -->
            <%
                var slides = (sliders && sliders.length) ? sliders : [{ image: 'https://cdn.100bytes.co.ao/hero/hero1.png', link: '' }];
                var cartoes = [];
                if (typeof destaques !== 'undefined' && destaques) {
                    if (destaques.novidade) cartoes.push({ etiqueta: 'Chegou agora', p: destaques.novidade });
                    if (destaques.procurado) cartoes.push({ etiqueta: 'Mais procurado', p: destaques.procurado });
                }
            %>
