            <script>
            (function () {
                try {
                    var list = JSON.parse(localStorage.getItem('recently_viewed') || '[]');
                    if (!list.length) return;
                    var section = document.getElementById('recently-viewed-section');
                    var container = document.getElementById('recently-viewed-list');
                    var html = '';
                    list.forEach(function (p) {
                        var oldHtml = p.salePrice ? '<div class="rv-card-old">' + p.basePrice + '</div>' : '';
                        var priceHtml = p.salePrice
                            ? '<div class="rv-card-price">' + p.salePrice + '</div>'
                            : '<div class="rv-card-price-normal">' + p.basePrice + '</div>';
                        var imgHtml = p.image
                            ? '<img src="' + p.image + '" alt="' + p.name.replace(/"/g, '') + '">'
                            : '<div style="width:80px;height:80px;background:#f5f5f5;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:10px;color:#ccc">Sem imagem</div>';
                        var cat = p.category ? '<div class="rv-card-cat">' + p.category + '</div>' : '';
                        html += '<div class="rv-card">'
                            + '<a href="/' + (p.categorySlug || '') + '/' + p.urlKey + '" style="text-decoration:none;color:inherit">'
                            + '<div class="rv-card-img">' + imgHtml + '</div>'
                            + '<div class="rv-card-body">'
                            + cat
                            + '<div class="rv-card-name">' + p.name + '</div>'
                            + oldHtml + priceHtml
                            + '</div>'
                            + '</a>'
                            + '<a href="/' + (p.categorySlug || '') + '/' + p.urlKey + '" class="rv-card-btn">'
                            + '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>'
                            + ' ADICIONAR'
                            + '</a>'
                            + '</div>';
                    });
                    container.innerHTML = html;
                    section.style.display = '';
                } catch (e) {}
            })();
            </script>
