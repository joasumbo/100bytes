                    .rv-card-btn { display:flex; align-items:center; justify-content:center; gap:5px; margin:6px 8px 8px; padding:8px 0; background:#F57C00; color:#fff; border-radius:8px; font-size:11px; font-weight:700; text-decoration:none; transition:background .2s; letter-spacing:.3px; }
                    .rv-card-btn:hover { background:#d96a00; color:#fff; text-decoration:none; }
                    @media (max-width:767.98px) { .rv-side { flex:0 0 130px; padding:20px 12px; } .rv-card { flex:0 0 140px; } }
                </style>
