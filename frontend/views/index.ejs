    <script>
        // Topo da página inicial: carrossel leve (deslizar, setas, pastilhas com progresso,
        // pausa ao passar o rato ou quando o separador não está visível).
        (function hhIniciar() {
            var slider = document.getElementById('hhSlider');
            var track = document.getElementById('hhTrack');
            if (!slider || !track) return;
            var slides = track.children;
            var dots = Array.prototype.slice.call(document.querySelectorAll('#hhDots .hh-dot'));
            var TEMPO = 6000;
            slider.style.setProperty('--hh-tempo', TEMPO / 1000 + 's');
            var atual = 0, temporizador = null, pausado = false;

            function marcar(i) {
                dots.forEach(function (d, k) {
                    d.classList.toggle('on', k === i);
                    var s = d.firstElementChild;
                    if (s) { s.style.animation = 'none'; void s.offsetWidth; s.style.animation = ''; }
                });
            }
            function ir(i) {
                if (!slides.length) return;
                atual = (i + slides.length) % slides.length;
                track.scrollTo({ left: track.clientWidth * atual, behavior: 'smooth' });
                marcar(atual);
                agendar();
            }
            function agendar() {
                clearTimeout(temporizador);
                if (slides.length > 1 && !pausado) temporizador = setTimeout(function () { ir(atual + 1); }, TEMPO);
            }
            function pausar(sim) {
                pausado = sim;
                slider.classList.toggle('pausa', sim);
                if (sim) clearTimeout(temporizador); else agendar();
            }

            var ant = document.getElementById('hhAnt'), seg = document.getElementById('hhSeg');
            if (ant) ant.addEventListener('click', function () { ir(atual - 1); });
            if (seg) seg.addEventListener('click', function () { ir(atual + 1); });
            dots.forEach(function (d, k) { d.addEventListener('click', function () { ir(k); }); });

            // Deslizar com o dedo / roda: acompanhar o slide visível
            var fimScroll = null;
            track.addEventListener('scroll', function () {
                clearTimeout(fimScroll);
                fimScroll = setTimeout(function () {
                    var i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
                    if (i !== atual) { atual = i; marcar(i); agendar(); }
                }, 120);
            }, { passive: true });

            slider.addEventListener('mouseenter', function () { pausar(true); });
            slider.addEventListener('mouseleave', function () { pausar(false); });
            slider.addEventListener('focusin', function () { pausar(true); });
            slider.addEventListener('focusout', function () { pausar(false); });
            document.addEventListener('visibilitychange', function () { pausar(document.hidden); });
            window.addEventListener('resize', function () { track.scrollTo({ left: track.clientWidth * atual }); });

            // Medir: clique em cada destaque
            slider.addEventListener('click', function (e) {
                var a = e.target.closest('.hh-link');
                if (a && window.bbTrack) window.bbTrack('search_click', { meta: { source: 'hero', slide: Number(a.dataset.slide) } });
            });

            agendar();
        })();
    </script>
</body>
</html>







