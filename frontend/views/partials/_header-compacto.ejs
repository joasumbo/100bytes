<!-- Cabeçalho compacto (uma linha): usado na página de produto -->
<header id="header" class="hc">
    <div class="hc-row">
        <a href="/" class="hc-logo" aria-label="100 bytes — página inicial">
            <img src="/img/logo-icone.png" alt="100 bytes" width="44" height="48">
        </a>

        <form class="hc-search" action="/pesquisa" method="GET" role="search">
            <i class="ec ec-search"></i>
            <input type="search" name="q" placeholder="Pesquisar produtos, marcas ou código" aria-label="Pesquisar produtos" autocomplete="off">
        </form>

        <nav class="hc-nav" aria-label="Navegação principal">
            <a href="/promocoes" class="hc-sale">Promoções</a>
            <a href="/novidades">Novidades</a>
            <a href="/mais-vendidos">Mais vendidos</a>
            <div class="hc-drop">
                <button type="button" class="hc-drop-btn" aria-haspopup="true" aria-expanded="false">Categorias <i class="fas fa-chevron-down"></i></button>
                <div class="hc-drop-menu">
                    <% (typeof categories !== 'undefined' && categories ? categories : []).forEach(function (cat) { %>
                    <a href="/<%= cat.slug %>"><%= cat.name %></a>
                    <% }) %>
                </div>
            </div>
            <a href="/apoio-ao-cliente">Ajuda</a>
        </nav>

        <div class="hc-actions">
            <div class="hc-fav">
                <a href="javascript:;" id="favHeaderBtn" class="hc-icon" title="Favoritos">
                    <i class="ec ec-favorites"></i>
                    <span id="favBadge" class="hc-badge" style="display:none"></span>
                </a>
                <div id="favDropdown" style="display:none;position:absolute;top:calc(100% + 12px);right:-40px;width:320px;background:#fff;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,.15);z-index:10000;overflow:hidden;">
                    <div style="padding:12px 16px;border-bottom:1px solid #f0f0f0;font-weight:600;font-size:14px;color:#333;">Favoritos</div>
                    <div id="favDropdownBody" style="min-height:60px;max-height:270px;overflow-y:auto;"></div>
                    <div style="padding:10px 16px;border-top:1px solid #f0f0f0;text-align:center;">
                        <a href="/perfil#favoritos" style="color:#F57C00;font-weight:600;font-size:13px;text-decoration:none;">Ver todos os favoritos →</a>
                    </div>
                </div>
            </div>

            <a href="javascript:;" class="hc-icon js-cart-drawer-trigger" role="button" aria-controls="cartDrawer" title="Carrinho">
                <i class="ec ec-shopping-bag"></i>
                <span class="hc-badge js-cart-count" style="display:none!important;"></span>
            </a>

            <% if (typeof currentCustomer !== 'undefined' && currentCustomer) { %>
            <a href="/perfil" class="hc-enter"><i class="ec ec-user"></i> <span><%= String(currentCustomer.name || 'Conta').split(' ')[0] %></span></a>
            <% } else { %>
            <a href="javascript:customerAuth.showLoginModal();" class="hc-enter"><i class="ec ec-user"></i> <span>Entrar</span></a>
            <% } %>

            <button type="button" class="hc-burger" aria-label="Abrir menu" aria-expanded="false"><i class="fas fa-bars"></i></button>
        </div>
    </div>

    <!-- Menu do telemóvel -->
    <div class="hc-mobile" hidden>
        <a href="/promocoes" class="hc-sale">Promoções</a>
        <a href="/novidades">Novidades</a>
        <a href="/mais-vendidos">Mais vendidos</a>
        <a href="/apoio-ao-cliente">Apoio ao cliente</a>
        <a href="/rastreio">Acompanhar encomenda</a>
        <div class="hc-mobile-title">Categorias</div>
        <% (typeof categories !== 'undefined' && categories ? categories : []).forEach(function (cat) { %>
        <a href="/<%= cat.slug %>"><%= cat.name %></a>
        <% }) %>
    </div>
</header>

<style>
    .hc { position:sticky; top:0; z-index:1000; background:#fff; border-bottom:1px solid #e6e6ea; }
    .hc-row { display:flex; align-items:center; gap:28px; height:86px; padding:0 32px; max-width:1920px; margin:0 auto; }
    .hc-logo { flex:0 0 auto; display:flex; align-items:center; }
    .hc-logo img { height:46px; width:auto; display:block; }
    .hc-search { flex:0 1 560px; min-width:200px; position:relative; }
    .hc-search i { position:absolute; left:18px; top:50%; transform:translateY(-50%); font-size:19px; color:#555; pointer-events:none; }
    .hc-search input { width:100%; height:52px; border:1px solid #d9d9df; border-radius:999px; padding:0 20px 0 50px; font-size:16px; color:#1a1a2e; background:#fff; outline:none; transition:border-color .15s, box-shadow .15s; }
    .hc-search input:focus { border-color:#F57C00; box-shadow:0 0 0 3px rgba(245,124,0,.15); }
    .hc-search input::-webkit-search-cancel-button { -webkit-appearance:none; }
    .hc-nav { flex:1 1 auto; display:flex; align-items:center; justify-content:flex-end; gap:30px; white-space:nowrap; }
    .hc-nav > a, .hc-drop-btn { font-size:17px; font-weight:500; color:#1a1a2e; text-decoration:none; background:none; border:0; padding:0; cursor:pointer; display:inline-flex; align-items:center; gap:6px; }
    .hc-nav > a:hover, .hc-drop-btn:hover { color:#F57C00; text-decoration:none; }
    .hc-sale { color:#e53935 !important; }
    .hc-drop { position:relative; }
    .hc-drop-btn i { font-size:11px; }
    .hc-drop-menu { display:none; position:absolute; top:calc(100% + 18px); right:-16px; min-width:240px; max-height:70vh; overflow:auto; background:#fff; border-radius:12px; box-shadow:0 10px 30px rgba(16,24,40,.14); padding:8px 0; z-index:1001; }
    .hc-drop-menu a { display:block; padding:9px 18px; font-size:14px; color:#1a1a2e; text-decoration:none; }
    .hc-drop-menu a:hover { background:#f5f6f8; color:#F57C00; }
    .hc-drop.is-open .hc-drop-menu { display:block; }
    .hc-actions { flex:0 0 auto; display:flex; align-items:center; gap:18px; }
    .hc-fav { position:relative; }
    .hc-icon { position:relative; display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; color:#1a1a2e !important; font-size:22px; text-decoration:none !important; cursor:pointer; }
    .hc-badge { position:absolute; top:0; right:-2px; min-width:18px; height:18px; padding:0 4px; border-radius:999px; background:#F57C00; color:#fff; font-size:10px; font-weight:700; line-height:18px; text-align:center; }
    .hc-enter { display:inline-flex; align-items:center; gap:8px; height:52px; padding:0 22px; border-radius:999px; background:#f1f2f4; color:#1a1a2e !important; font-size:16px; font-weight:600; text-decoration:none !important; white-space:nowrap; }
    .hc-enter:hover { background:#e7e8eb; }
    .hc-enter i { font-size:18px; }
    .hc-burger { display:none; width:42px; height:42px; border:0; border-radius:50%; background:#f1f2f4; color:#1a1a2e; font-size:18px; cursor:pointer; }
    .hc-mobile { border-top:1px solid #eee; padding:8px 16px 16px; max-height:75vh; overflow:auto; }
    .hc-mobile a { display:block; padding:10px 0; font-size:15px; color:#1a1a2e; text-decoration:none; border-bottom:1px solid #f3f3f5; }
    .hc-mobile-title { font-size:12px; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:.5px; margin:14px 0 2px; }

    @media (max-width: 1399.98px) {
        .hc-row { gap:20px; padding:0 20px; }
        .hc-nav { gap:20px; }
        .hc-nav > a, .hc-drop-btn { font-size:15px; }
    }
    @media (max-width: 1199.98px) {
        .hc-nav { display:none; }
        .hc-search { flex:1 1 auto; }
        .hc-burger { display:inline-flex; align-items:center; justify-content:center; }
    }
    @media (max-width: 767.98px) {
        .hc-row { height:64px; gap:10px; padding:0 12px; }
        .hc-search { min-width:0; }
        .hc-burger, .hc-enter { width:38px; height:38px; flex:0 0 38px; }
        .hc-icon { width:32px; }
        .hc-logo img { height:36px; }
        .hc-search input { height:42px; font-size:14px; padding-left:40px; }
        .hc-search i { left:14px; font-size:16px; }
        .hc-actions { gap:6px; }
        .hc-fav { display:none; }
        .hc-enter { width:42px; height:42px; padding:0; justify-content:center; }
        .hc-enter span { display:none; }
    }
    @media (min-width: 768px) {
        .hc-row { height:64px; gap:22px; padding:0 28px; }
        .hc-logo img { height:36px; }
        .hc-search { flex-basis:460px; }
        .hc-search input { height:42px; font-size:14px; padding-left:42px; }
        .hc-search i { left:16px; font-size:16px; }
        .hc-nav { gap:22px; }
        .hc-nav > a, .hc-drop-btn { font-size:14px; }
        .hc-actions { gap:12px; }
        .hc-icon { width:34px; height:34px; font-size:19px; }
        .hc-enter { height:40px; padding:0 18px; font-size:14px; }
        .hc-enter i { font-size:15px; }
        .hc-drop-menu { top:calc(100% + 14px); }
    }
</style>

<script>
    (function () {
        // Categorias (computador) e menu do telemóvel
        var drop = document.querySelector('.hc-drop');
        if (drop) {
            var btn = drop.querySelector('.hc-drop-btn');
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var aberto = drop.classList.toggle('is-open');
                btn.setAttribute('aria-expanded', aberto ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (!drop.contains(e.target)) { drop.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
            });
        }
        var burger = document.querySelector('.hc-burger');
        var painel = document.querySelector('.hc-mobile');
        if (burger && painel) {
            burger.addEventListener('click', function () {
                var abrir = painel.hasAttribute('hidden');
                if (abrir) painel.removeAttribute('hidden'); else painel.setAttribute('hidden', '');
                burger.setAttribute('aria-expanded', abrir ? 'true' : 'false');
                burger.innerHTML = abrir ? '<i class="fas fa-times"></i>' : '<i class="fas fa-bars"></i>';
            });
        }
    })();
</script>
