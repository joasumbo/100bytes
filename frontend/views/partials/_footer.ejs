        font-size: 14px; font-weight: 600; opacity: 0;
        transition: max-width .25s ease, opacity .2s ease;
    }
    .wa-float:hover .wa-float__label, .wa-float:focus .wa-float__label { max-width: 160px; opacity: 1; }
    .wa-float:focus-visible { outline: 3px solid #128C7E; outline-offset: 3px; }
