    .ft-logo img { height:64px; width:auto; display:block; filter:brightness(0) invert(1); }
    .ft-sobre { margin:16px 0 0; max-width:440px; line-height:1.65; }
    .ft-news-tit { color:#fff; font-size:17px; font-weight:600; margin:0 0 4px; }
    .ft-news-sub { margin:0 0 14px; }
    .ft-news-form { display:flex; gap:8px; max-width:520px; }
    .ft-news-form input { flex:1; min-width:0; height:46px; border-radius:999px; border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.06); color:#fff; padding:0 20px; font-size:14px; outline:none; transition:border-color .15s, background .15s; }
    .ft-news-form input::placeholder { color:#71717a; }
    .ft-news-form input:focus { border-color:#F57C00; background:rgba(255,255,255,.09); }
    .ft-news-form button { height:46px; padding:0 22px; border:0; border-radius:999px; background:#F57C00; color:#fff; font-size:14px; font-weight:600; cursor:pointer; white-space:nowrap; transition:background .15s; }
    .ft-news-form button:hover { background:#e06f00; }
    .ft-news-ok { display:none; color:#fff; margin-top:10px; font-size:13px; }

    /* Colunas de links */
    .ft-cols { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)) minmax(0,1.6fr); gap:32px; padding:40px 0; border-bottom:1px solid rgba(255,255,255,.08); }
    .ft-tit { color:#fff; font-size:14px; font-weight:600; margin:0 0 16px; }
    .ft-lista { list-style:none; margin:0; padding:0; }
    .ft-lista li + li { margin-top:10px; }

    /* Lojas */
    .ft-lojas { display:grid; grid-template-columns:1fr 1fr; gap:20px 24px; }
    .ft-loja-nome { color:#fff; font-weight:500; margin-bottom:4px; }
    .ft-loja p { margin:0; line-height:1.55; }
    .ft-loja a { color:#fff; }
    .ft-loja a:hover { color:#F57C00; }
    .ft-contacto { grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:8px 20px; padding-top:4px; }
    .ft-contacto a { display:inline-flex; align-items:center; gap:8px; color:#fff; }
    .ft-contacto a:hover { color:#F57C00; }
    .ft-contacto svg { width:16px; height:16px; color:#71717a; }

    /* Base: redes, pagamentos, direitos */
    .ft-base { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px 24px; padding:22px 0 26px; font-size:13px; }
    .ft-redes { display:flex; gap:8px; }
    .ft-redes a { width:38px; height:38px; border-radius:50%; border:1px solid rgba(255,255,255,.14); display:inline-flex; align-items:center; justify-content:center; color:#d4d4d8; transition:background .15s, border-color .15s, color .15s; }
    .ft-redes a:hover { background:#F57C00; border-color:#F57C00; color:#fff; }
    .ft-redes svg { width:17px; height:17px; }
    .ft-pag { display:flex; align-items:center; gap:10px; }
    .ft-pag-item { height:30px; padding:0 12px; border-radius:6px; background:#fff; display:inline-flex; align-items:center; gap:6px; color:#16161d; font-size:12px; font-weight:600; }
    .ft-pag-item img { height:18px; width:auto; }
    .ft-legal { display:flex; flex-wrap:wrap; align-items:center; gap:6px 18px; color:#71717a; }

    @media (max-width: 991.98px) {
        .ft-topo { grid-template-columns:1fr; gap:28px; padding:36px 0 32px; }
        .ft-cols { grid-template-columns:1fr 1fr; gap:28px 20px; }
        .ft-cols > .ft-col-lojas { grid-column:1 / -1; }
    }
    @media (max-width: 575.98px) {
        .ft-lojas { grid-template-columns:1fr; }
        .ft-news-form { flex-direction:column; }
        .ft-base { flex-direction:column; align-items:flex-start; }
    }
</style>

