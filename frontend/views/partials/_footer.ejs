<style>
    /* Fonte global do site: Poppins. Aplicada na base + elementos-chave para
       herdar em todo o texto; os ícones (FontAwesome / electro) mantêm a sua
       própria font porque definem font-family nas suas classes. */
    html, body, button, input, select, textarea, optgroup,
    h1, h2, h3, h4, h5, h6, .btn, .form-control, .nav-link, .dropdown-item, .badge {
        font-family: 'Poppins', Helvetica, Arial, sans-serif !important;
    }

    .site-footer { background: #fff; }
    .site-footer a { transition: color .15s, padding-left .15s; }

    /* Newsletter */
    .footer-news { background: #F57C00; padding: 30px 0; }
    .footer-news__title { font-size: 18px; font-weight: 700; margin-bottom: 4px; color: #fff; }
    .footer-news__sub { font-size: 13px; color: #fff; opacity: .9; }
    .footer-news__form { display: flex; flex: 1; min-width: 260px; max-width: 480px; border-radius: 8px; overflow: hidden; }
    .footer-news__form input { flex: 1; border: 0; outline: 0; padding: 0 16px; height: 48px; font-size: 13px; }
    .footer-news__form button { background: #1a1a2e; color: #fff; border: 0; padding: 0 24px; font-weight: 700; font-size: 12px; letter-spacing: .6px; height: 48px; cursor: pointer; transition: background .2s; }
    .footer-news__form button:hover { background: #000; }

    /* Main */
    .footer-main { padding: 48px 0 24px; border-top: 1px solid #eee; }
    .footer-col__title { font-weight: 700; font-size: 12px; letter-spacing: .8px; text-transform: uppercase; color: #1a1a2e; margin: 0 0 14px; padding-bottom: 10px; position: relative; }
    .footer-col__title::after { content: ""; position: absolute; left: 0; bottom: 0; width: 32px; height: 2px; background: #F57C00; }
    .footer-links { list-style: none; padding: 0; margin: 0; }
    .footer-links li { margin-bottom: 9px; }
    .footer-links a { font-size: 13px; color: #5a5a6a; text-decoration: none; }
    .footer-links a:hover { color: #F57C00; padding-left: 4px; }

    .footer-about__text { font-size: 13px; color: #666; line-height: 1.75; margin-bottom: 10px; }
    .footer-about__tag { font-size: 13px; font-style: italic; color: #1a1a2e; font-weight: 600; margin-bottom: 18px; }

    /* Social icons */
    .footer-social { display: flex; gap: 10px; }
    .footer-social a {
        width: 40px; height: 40px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 17px; text-decoration: none;
        transition: transform .18s, box-shadow .18s, opacity .18s;
    }
    .footer-social a:hover { transform: translateY(-3px); box-shadow: 0 6px 14px rgba(0,0,0,.18); opacity: .95; }
    .footer-social .s-ig { background: linear-gradient(45deg, #f09433, #e6683c 30%, #dc2743 55%, #cc2366 75%, #bc1888); }
    .footer-social .s-fb { background: #1877f2; }
    .footer-social .s-wa { background: #25d366; }

    /* Contact blocks */
    .footer-contact__group { margin-bottom: 18px; }
    .footer-contact__label { font-weight: 700; font-size: 12px; color: #1a1a2e; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .3px; }
    .footer-contact__row { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 6px; font-size: 13px; color: #5a5a6a; line-height: 1.5; }
    .footer-contact__row i { color: #F57C00; font-size: 13px; margin-top: 3px; flex-shrink: 0; width: 14px; text-align: center; }
    .footer-contact__row a { color: #F57C00; text-decoration: none; }
    .footer-contact__row a:hover { text-decoration: underline; }

    /* Bottom */
    .footer-bottom { background: #1a1a2e; padding: 16px 0; }
    .footer-bottom__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .footer-bottom span { font-size: 12px; color: #aab; }
    .footer-bottom .footer-bottom__pay { font-size: 12px; color: #889; letter-spacing: .3px; }
</style>

