    }
    .wa-float:hover, .wa-float:focus {
        color: #fff; text-decoration: none;
        box-shadow: 0 10px 28px rgba(37,211,102,.6); transform: translateY(-2px);
        gap: 10px; padding-right: 22px;
    }
    .wa-float i { font-size: 28px; line-height: 1; }
    /* O rótulo só se revela ao passar o rato — em repouso fica só o ícone. */
