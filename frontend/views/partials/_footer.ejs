<script>
    (function () {
        var f = document.getElementById("ftNews");
        if (!f) return;
        f.addEventListener("submit", function (e) {
            e.preventDefault();
            var i = document.getElementById("ftNewsEmail");
            if (!i.value || !i.checkValidity()) { i.focus(); i.reportValidity && i.reportValidity(); return; }
            // Guardado no registo de eventos (tipo newsletter) até haver lista própria no admin
            var ev = { meta: { email: i.value.trim().toLowerCase() } };
            if (window.bbTrack) window.bbTrack("newsletter", ev);
            else fetch("/api/events", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ sessionId: "rodape-newsletter", events: [{ type: "newsletter", meta: ev.meta }] }), keepalive: true }).catch(function () {});
            f.style.display = "none";
            document.getElementById("ftNewsOk").style.display = "block";
        });
    })();
</script>
