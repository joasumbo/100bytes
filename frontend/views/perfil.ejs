<!DOCTYPE html>
<html lang="pt-AO">
<head>
    <%- include('partials/_seo', { tituloPadrao: 'A minha conta | 100 bytes' }) %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
    <link rel="stylesheet" href="/css/loja.css">
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
</head>
<body class="lj">
    <%- include('partials/_header-compacto') %>

    <% var pfProvincias = ["Bengo","Benguela","Bié","Cabinda","Cuando Cubango","Cuanza Norte","Cuanza Sul","Cunene","Huambo","Huíla","Luanda","Lunda Norte","Lunda Sul","Malanje","Moxico","Namibe","Uíge","Zaire"]; %>

    <main id="content" role="main" class="lj-main">
        <div class="container">

            <div class="pf-carregar" id="pfCarregar">A carregar a sua conta…</div>

            <!-- ── Completar a conta (depois de entrar com Google) ── -->
            <div id="pfCompletar" class="pf-completar" hidden>
                <div class="lj-card pf-completar-card">
                    <div class="pf-completar-topo">
                        <span class="pf-avatar pf-avatar-g" data-pf-avatar></span>
                        <div>
                            <h1 class="lj-titulo" style="font-size:24px;">Falta pouco, <span data-pf-primeiro></span></h1>
                            <p class="lj-sub">Complete a sua conta para comprar mais depressa. Só precisamos disto uma vez.</p>
                        </div>
                    </div>
                    <form id="pfCompletarForm" novalidate>
                        <h2 class="lj-sec"><span class="lj-num">1</span>Contacto</h2>
                        <div class="lj-grelha">
                            <div class="lj-campo">
                                <label for="cpPhone">Telefone</label>
                                <input id="cpPhone" class="lj-input" type="tel" placeholder="+244 9xx xxx xxx" autocomplete="tel" inputmode="tel">
                            </div>
                            <div class="lj-campo">
                                <label>Email</label>
                                <input class="lj-input" type="email" data-pf-email disabled>
                            </div>
                        </div>
                        <h2 class="lj-sec" style="margin-top:26px;"><span class="lj-num">2</span>Morada de entrega</h2>
                        <div class="lj-grelha">
                            <div class="lj-campo">
                                <label for="cpProvince">Província</label>
                                <select id="cpProvince" class="lj-input">
                                    <option value="">Selecionar</option>
                                    <% pfProvincias.forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %>
                                </select>
                            </div>
                            <div class="lj-campo">
                                <label for="cpCity">Município</label>
                                <input id="cpCity" class="lj-input" type="text" placeholder="Ex: Luanda, Viana, Talatona" autocomplete="address-level2">
                            </div>
                            <div class="lj-campo lj-larga">
                                <label for="cpAddress">Morada</label>
                                <input id="cpAddress" class="lj-input" type="text" placeholder="Rua, número, bairro e um ponto de referência" autocomplete="street-address">
                            </div>
                        </div>
                        <div id="cpPassBloco">
                            <h2 class="lj-sec" style="margin-top:26px;"><span class="lj-num">3</span>Palavra-passe</h2>
                            <div class="lj-campo">
                                <label for="cpPassword">Escolha uma palavra-passe <span class="opc">(para entrar também sem o Google)</span></label>
                                <div class="pf-pass">
                                    <input id="cpPassword" class="lj-input" type="password" placeholder="Pelo menos 8 caracteres" autocomplete="new-password">
                                    <button type="button" class="pf-olho" data-olho="cpPassword" aria-label="Mostrar palavra-passe"><i class="far fa-eye"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="pf-msg" id="cpMsg" role="alert"></div>
                        <div class="pf-acoes">
                            <button type="submit" class="lj-btn lj-btn-marca" id="cpGuardar">Guardar e continuar</button>
                            <a href="#" class="pf-depois" id="cpDepois">Fazer depois</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── Conta ── -->
            <div id="pfConta" class="pf-conta" hidden>
                <aside class="pf-lado">
                    <div class="lj-card pf-cartao">
                        <div class="pf-foto-wrap">
                            <span class="pf-avatar" data-pf-avatar></span>
                            <label class="pf-foto-btn" title="Alterar foto">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3"/></svg>
                                <input type="file" id="pfFotoInput" accept="image/jpeg,image/png,image/webp" hidden>
                            </label>
                        </div>
                        <div class="pf-nome" data-pf-nome></div>
                        <div class="pf-email" data-pf-email-txt></div>
                        <div class="pf-desde" id="pfDesde"></div>
                    </div>
                    <nav class="lj-card pf-nav" aria-label="Conta">
                        <a href="#dados" data-tab="dados"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>Dados pessoais</a>
                        <a href="#morada" data-tab="morada"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>Morada</a>
                        <a href="#seguranca" data-tab="seguranca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Segurança</a>
                        <a href="#encomendas" data-tab="encomendas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Encomendas</a>
                        <a href="#favoritos" data-tab="favoritos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/></svg>Favoritos</a>
                        <button type="button" class="pf-sair" data-customer-logout><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>Terminar sessão</button>
                    </nav>
                </aside>

                <div class="pf-conteudo">
                    <!-- Dados pessoais -->
                    <section class="pf-sec" id="tab-dados">
                        <div class="lj-topo" style="margin-bottom:16px;">
                            <h1 class="lj-titulo">Dados pessoais</h1>
                            <p class="lj-sub">O seu nome e contacto para as encomendas.</p>
                        </div>
                        <form class="lj-card" id="pfDadosForm" novalidate>
                            <div class="lj-grelha">
                                <div class="lj-campo">
                                    <label for="pfName">Nome</label>
                                    <input id="pfName" class="lj-input" type="text" autocomplete="name">
                                </div>
                                <div class="lj-campo">
                                    <label for="pfPhone">Telefone</label>
                                    <input id="pfPhone" class="lj-input" type="tel" placeholder="+244 9xx xxx xxx" autocomplete="tel" inputmode="tel">
                                </div>
                                <div class="lj-campo lj-larga">
                                    <label>Email <span class="opc" id="pfEmailNota"></span></label>
                                    <input class="lj-input" type="email" data-pf-email disabled>
                                </div>
                            </div>
                            <div class="pf-msg" id="pfDadosMsg" role="status"></div>
                            <div class="pf-acoes"><button type="submit" class="lj-btn lj-btn-escuro">Guardar alterações</button></div>
                        </form>
                    </section>

                    <!-- Morada -->
                    <section class="pf-sec" id="tab-morada" hidden>
                        <div class="lj-topo" style="margin-bottom:16px;">
                            <h1 class="lj-titulo">Morada de entrega</h1>
                            <p class="lj-sub">Usamos esta morada para preencher o checkout automaticamente.</p>
                        </div>
                        <form class="lj-card" id="pfMoradaForm" novalidate>
                            <div class="lj-grelha">
                                <div class="lj-campo">
                                    <label for="pfProvince">Província</label>
                                    <select id="pfProvince" class="lj-input">
                                        <option value="">Selecionar</option>
                                        <% pfProvincias.forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %>
                                    </select>
                                </div>
                                <div class="lj-campo">
                                    <label for="pfCity">Município</label>
                                    <input id="pfCity" class="lj-input" type="text" placeholder="Ex: Luanda, Viana, Talatona" autocomplete="address-level2">
                                </div>
                                <div class="lj-campo lj-larga">
                                    <label for="pfAddress">Morada</label>
                                    <input id="pfAddress" class="lj-input" type="text" placeholder="Rua, número, bairro e um ponto de referência" autocomplete="street-address">
                                </div>
                            </div>
                            <div class="pf-msg" id="pfMoradaMsg" role="status"></div>
                            <div class="pf-acoes"><button type="submit" class="lj-btn lj-btn-escuro">Guardar morada</button></div>
                        </form>
                    </section>

                    <!-- Segurança -->
                    <section class="pf-sec" id="tab-seguranca" hidden>
                        <div class="lj-topo" style="margin-bottom:16px;">
                            <h1 class="lj-titulo">Segurança</h1>
                            <p class="lj-sub" id="pfSegSub">Altere a palavra-passe da sua conta.</p>
                        </div>
                        <form class="lj-card" id="pfPassForm" novalidate>
                            <div class="lj-grelha">
                                <div class="lj-campo lj-larga" id="pfAtualBloco">
                                    <label for="pfPassAtual">Palavra-passe atual</label>
                                    <div class="pf-pass">
                                        <input id="pfPassAtual" class="lj-input" type="password" autocomplete="current-password">
                                        <button type="button" class="pf-olho" data-olho="pfPassAtual" aria-label="Mostrar palavra-passe"><i class="far fa-eye"></i></button>
                                    </div>
                                </div>
                                <div class="lj-campo lj-larga">
                                    <label for="pfPassNova">Nova palavra-passe</label>
                                    <div class="pf-pass">
                                        <input id="pfPassNova" class="lj-input" type="password" placeholder="Pelo menos 8 caracteres" autocomplete="new-password">
                                        <button type="button" class="pf-olho" data-olho="pfPassNova" aria-label="Mostrar palavra-passe"><i class="far fa-eye"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div class="pf-msg" id="pfPassMsg" role="status"></div>
                            <div class="pf-acoes"><button type="submit" class="lj-btn lj-btn-escuro" id="pfPassBtn">Mudar palavra-passe</button></div>
                        </form>
                        <div class="lj-card pf-google" data-push-bloco hidden>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:#E06F00" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                            <div style="flex:1;"><strong>Notificações neste aparelho</strong><span data-push-estado>Desligadas</span></div>
                            <button type="button" class="lj-btn lj-btn-escuro" data-push-ativar="conta" style="height:40px;font-size:14px;">Ativar</button>
                            <button type="button" class="lj-btn lj-btn-linha" data-push-desativar hidden style="height:40px;font-size:14px;">Desligar</button>
                        </div>
                        <div class="lj-card pf-google" id="pfGoogleCard" hidden>
                            <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                            <div><strong>Conta Google ligada</strong><span>Pode entrar com o botão "Continuar com Google".</span></div>
                        </div>
                    </section>

                    <!-- Encomendas -->
                    <section class="pf-sec" id="tab-encomendas" hidden>
                        <div class="lj-topo" style="margin-bottom:16px;">
                            <h1 class="lj-titulo">Encomendas</h1>
                            <p class="lj-sub">Acompanhe o estado das suas encomendas.</p>
                        </div>
                        <div id="ordersList"><div class="lj-card pf-vazio">A carregar…</div></div>
                    </section>

                    <!-- Favoritos -->
                    <section class="pf-sec" id="tab-favoritos" hidden>
                        <div class="lj-topo" style="margin-bottom:16px;">
                            <h1 class="lj-titulo">Favoritos</h1>
                            <p class="lj-sub" id="favCount">Os produtos que guardou.</p>
                        </div>
                        <div id="favGrid" class="pf-favs"><div class="lj-card pf-vazio">A carregar…</div></div>
                    </section>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/_footer') %>
    <%- include('partials/_customer-auth-modals') %>

    <script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
    <script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
    <script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
    <script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
    <script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
    <script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
    <script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
    <script src="/assets/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="/assets/js/hs.core.js"></script>
    <script src="/assets/js/components/hs.header.js"></script>
    <script src="/assets/js/components/hs.hamburgers.js"></script>
    <script src="/assets/js/components/hs.unfold.js"></script>
    <script src="/assets/js/components/hs.focus-state.js"></script>
    <script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
    <script src="/assets/js/components/hs.svg-injector.js"></script>
    <script src="/assets/js/components/hs.go-to.js"></script>
    <script src="/assets/js/components/hs.selectpicker.js"></script>

    <script>
    $(window).on('load', function () {
        $.HSCore.components.HSHeader && $.HSCore.components.HSHeader.init($('#header'));
    });
    </script>
    <script src="/js/perfil.js"></script>
    <script src="/js/precos.js" defer></script>
    <script src="/js/comportamento.js" defer></script>
    <script src="/js/pesquisa.js" defer></script>
</body>
</html>
