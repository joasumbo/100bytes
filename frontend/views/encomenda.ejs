<!DOCTYPE html>
<html lang="pt-AO">
<head>
    <%- include('partials/_seo', { tituloPadrao: (order ? 'Encomenda ' + order.code : 'Encomenda não encontrada') + ' | 100 bytes' }) %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/css/theme.css">

    <link rel="stylesheet" href="/css/loja.css">
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
</head>
<body class="lj">

<%- include('partials/_header-compacto') %>

<main id="content" role="main" class="lj-main">
<div class="container">

    <% if (!order) { %>
    <div class="lj-card" style="max-width:560px;margin:40px auto;text-align:center;padding:40px 28px;">
        <h1 class="lj-titulo">Encomenda não encontrada</h1>
        <p class="lj-sub" style="margin-bottom:24px;">O código não existe ou foi escrito com um erro. Confirme o código que recebeu.</p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <a href="/rastreio" class="lj-btn lj-btn-escuro">Procurar outro código</a>
            <a href="/" class="lj-btn lj-btn-linha">Ir para a loja</a>
        </div>
    </div>

    <% } else { %>
    <%
    function fmtKz(v) {
        return Number(v || 0).toLocaleString('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
    }
    var estados = { pending:'Aguarda confirmação', confirmed:'Confirmada', preparing:'Em preparação', processing:'Em preparação', shipped:'A caminho', delivered:'Entregue', cancelled:'Cancelada' };
    var titulos = {
        pending:   ['Recebemos a sua encomenda', 'Obrigado. Vamos contactá-lo por telefone ou WhatsApp para confirmar a encomenda e a entrega.'],
        confirmed: ['Encomenda confirmada', 'Já estamos a tratar dela. Avisamos quando sair para entrega.'],
        preparing: ['Encomenda em preparação', 'Estamos a preparar os seus produtos.'],
        processing:['Encomenda em preparação', 'Estamos a preparar os seus produtos.'],
        shipped:   ['A sua encomenda vai a caminho', 'Em breve chega à morada indicada.'],
        delivered: ['Encomenda entregue', 'Obrigado por comprar na 100 bytes.'],
        cancelled: ['Encomenda cancelada', 'Se tiver dúvidas, fale connosco.'],
    };
    var t = titulos[order.status] || ['Encomenda ' + order.code, ''];
    %>

    <div class="lj-topo">
        <nav class="lj-trilho" aria-label="Caminho"><a href="/">Início</a><span class="sep">/</span><span>Encomenda</span></nav>
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;">
            <div>
                <span class="lj-estado <%= order.status %>"><%= estados[order.status] || order.status %></span>
                <h1 class="lj-titulo" style="margin-top:12px;"><%= t[0] %></h1>
                <p class="lj-sub"><%= t[1] %></p>
            </div>
            <div class="lj-codigo" title="Código da encomenda">
                <span id="orderCodeVal"><%= order.code %></span>
                <button type="button" id="btnCopiar" onclick="copyCode()">Copiar</button>
            </div>
        </div>
    </div>

    <%- include('partials/_encomenda-detalhe', { order: order, ejAcoes: '<div style="display:flex;flex-direction:column;gap:10px;margin-top:16px;"><a href="/rastreio/' + order.code + '" class="lj-btn lj-btn-escuro lj-btn-bloco">Acompanhar encomenda</a><a href="/" class="lj-btn lj-btn-linha lj-btn-bloco">Continuar a comprar</a></div>' }) %>
    <% } %>

</div>
</main>

<%- include('partials/_footer') %>

<script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
<script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
<script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
<script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
<script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
<script src="/assets/js/hs.core.js"></script>
<script src="/assets/js/components/hs.header.js"></script>
<script src="/assets/js/components/hs.hamburgers.js"></script>
<script src="/assets/js/components/hs.unfold.js"></script>
<script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
<script src="/assets/js/components/hs.svg-injector.js"></script>

<script>
$(window).on('load', function () {
    $('.js-mega-menu').HSMegaMenu({ event:'hover', direction:'horizontal', pageContainer:$('.container'), breakpoint:767.98, hideTimeOut:0 });
    $.HSCore.components.HSSVGIngector.init('.js-svg-injector');
});
$(document).ready(function () {
    $.HSCore.components.HSHeader.init($('#header'));
    $.HSCore.components.HSHamburgers.init('.hamburger');
    $.HSCore.components.HSUnfold.init($('[data-unfold-target]'), {
        afterOpen: function () { $(this).find('input[type="search"]').focus(); }
    });
    $.HSCore.components.HSMalihuScrollBar.init($('.js-scrollbar'));
});

function copyCode() {
    var code = document.getElementById('orderCodeVal');
    var btn = document.getElementById('btnCopiar');
    if (!code) return;
    function feito() { if (btn) { btn.textContent = 'Copiado'; setTimeout(function () { btn.textContent = 'Copiar'; }, 2000); } }
    if (navigator.clipboard) navigator.clipboard.writeText(code.textContent.trim()).then(feito).catch(function () {});
}
</script>

    <script src="/js/precos.js" defer></script>
    <script src="/js/comportamento.js" defer></script>
    <script src="/js/pesquisa.js" defer></script>
</body>
</html>
