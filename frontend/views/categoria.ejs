    <script src="/js/pesquisa.js" defer></script>
<script>
(function () {
    var filtros = document.getElementById('lsFiltros');
    var veu = document.querySelector('.ls-veu');
    function abrir() { if (!filtros) return; filtros.classList.add('aberto'); veu && veu.classList.add('aberto'); document.documentElement.style.overflow = 'hidden'; }
    function fechar() { if (!filtros) return; filtros.classList.remove('aberto'); veu && veu.classList.remove('aberto'); document.documentElement.style.overflow = ''; }
    document.querySelectorAll('[data-ls-abrir]').forEach(function (b) { b.addEventListener('click', abrir); });
    document.querySelectorAll('[data-ls-fechar]').forEach(function (b) { b.addEventListener('click', fechar); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fechar(); });
    document.querySelectorAll('[data-ls-mais]').forEach(function (b) {
        b.addEventListener('click', function () {
            var lista = b.previousElementSibling;
            var aberta = lista.classList.toggle('aberta');
            b.textContent = aberta ? 'Ver menos' : 'Ver mais ' + lista.querySelectorAll('.ls-extra').length;
        });
    });
    // número de resultados a contar até ao total
    var num = document.querySelector('.ls-num');
    if (num && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var alvo = parseInt(num.getAttribute('data-num'), 10) || 0, t0 = null;
        if (alvo > 1) {
            var passo = function (t) { t0 = t0 || t; var k = Math.min(1, (t - t0) / 600); num.textContent = Math.round(alvo * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(passo); };
            requestAnimationFrame(passo);
        }
    }
    // pesquisa: atalho "/" para ir à barra
    var pesq = document.querySelector('.ls-pesq-form input');
    if (pesq) document.addEventListener('keydown', function (e) {
        if (e.key === '/' && document.activeElement !== pesq && !/input|textarea|select/i.test(document.activeElement.tagName)) { e.preventDefault(); pesq.focus(); pesq.select(); }
    });
})();
</script>
</body>
