<!DOCTYPE html>
<html lang="pt-AO">
<%
const __pageTitle = (typeof pageTitle !== 'undefined') ? pageTitle : '';
const __category = (typeof category !== 'undefined') ? category : null;
const __pagination = (typeof pagination !== 'undefined') ? pagination : null;
const __currentFilters = (typeof currentFilters !== 'undefined' && currentFilters) ? currentFilters : {};
const __products = (typeof products !== 'undefined' && products) ? products : [];
const __categories = (typeof categories !== 'undefined' && categories) ? categories : [];
const __brands = (typeof brands !== 'undefined' && brands) ? brands : [];
const __topProducts = (typeof topProducts !== 'undefined' && topProducts) ? topProducts : [];
const __heading = __pageTitle || (__category ? __category.name : 'Produtos');
%>
<head>
    <%- include('partials/_seo', { tituloPadrao: __heading + ' | 100 bytes' }) %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">


    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/vendor/fancybox/jquery.fancybox.css">
    <link rel="stylesheet" href="/assets/vendor/slick-carousel/slick/slick.css">
    <link rel="stylesheet" href="/assets/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="/assets/css/theme.css">

    <link rel="stylesheet" href="/css/loja.css">
    <link rel="stylesheet" href="/css/listagem.css">
    <style>
        :root {
            --brand-primary: #F57C00;
            --brand-secondary: #D96A00;
        }

        .bg-primary,
        .badge-primary,
        .u-header .btn-primary,
        .u-header .btn-primary:not(:disabled):not(.disabled):active,
        .u-header .btn-primary:not(:disabled):not(.disabled).active {
            background-color: var(--brand-primary) !important;
            border-color: var(--brand-primary) !important;
        }

        .u-header-topbar {
            background-color: #ffffff !important;
            border-bottom: 1px solid #e6e6e6;
        }

        .btn-primary,
        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary:not(:disabled):not(.disabled):active,
        .btn-primary:not(:disabled):not(.disabled).active {
            background-color: var(--brand-primary) !important;
            border-color: var(--brand-primary) !important;
        }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-add-cart:hover,
        a.text-primary:hover,
        a:hover .text-primary {
            background-color: var(--brand-secondary) !important;
            border-color: var(--brand-secondary) !important;
            color: #fff !important;
        }

        .text-primary,
        .link-hover__brand:hover,
        .u-header__nav-link:hover,
        .u-header-topbar__nav-link:hover,
        .ec.ec-add-to-cart,
        .ec.ec-favorites {
            color: var(--brand-primary) !important;
        }

        .border-primary,
        .border-color-1,
        .nav-tab .nav-link.active::before,
        .nav-tab .nav-link:hover::before {
            border-color: var(--brand-primary) !important;
        }

        .u-header-topbar .topbar-left a,
        .u-header-topbar .u-header-topbar__nav-link,
        .u-header-topbar .dropdown-nav-link,
        .u-header-topbar .text-gray-50 {
            color: #2f2f33 !important;
        }

        .u-header-topbar .u-header-topbar__nav-item-border::after {
            border-color: rgba(47, 47, 51, 0.28) !important;
        }

        .u-header .form-control,
        .u-header .form-control::placeholder {
            color: #5f636b !important;
            font-weight: 600;
        }

        .bg-primary-down-lg {
            background-color: #ffffff !important;
        }

        .product-img-wrap {
            position: relative;
            display: block;
            overflow: hidden;
            height: 200px;
        }

        .product-img-wrap img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: opacity 0.35s ease;
        }

        .product-img-primary {
            opacity: 1;
            z-index: 1;
        }

        .product-img-hover {
            opacity: 0;
            z-index: 2;
        }

        .product-img-wrap:hover .product-img-primary {
            opacity: 0;
        }

        .product-img-wrap:hover .product-img-hover {
            opacity: 1;
        }

        .products-group .product-item__body {
            display: flex;
            flex-direction: column;
        }

        .product-item__title {
            min-height: 42px;
        }

        .prodcut-add-cart {
            display: block !important;
        }

        .btn-add-cart .ec {
            color: #fff !important;
        }
    </style>
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
</head>
<body class="lj">

<%- include('partials/_header-compacto') %>

<%
/* ── Dados da listagem (categoria, pesquisa, novidades, mais vendidos) ── */
var lsQ = (typeof searchQuery !== 'undefined' && searchQuery !== null) ? String(searchQuery) : null;
var lsPesquisa = lsQ !== null;
var lsUniverso = (typeof universo !== 'undefined' && universo && universo.length) ? universo : __products;
var lsF = __currentFilters;
var lsTotal = __pagination && __pagination.total ? __pagination.total : __products.length;

// endereço com filtros alterados (mantém os restantes)
function lsUrl(mudar) {
    var p = {};
    if (lsPesquisa && lsQ) p.q = lsQ;
    ['categoria', 'sort', 'minPrice', 'maxPrice', 'brandId', 'marca'].forEach(function (k) { if (lsF[k]) p[k] = lsF[k]; });
    Object.keys(mudar || {}).forEach(function (k) { if (mudar[k] === null || mudar[k] === '') delete p[k]; else p[k] = mudar[k]; });
    var qs = Object.keys(p).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(p[k]); }).join('&');
    return qs ? '?' + qs : '?';
}
function lsKz(v) { return Number(v).toLocaleString('pt-PT', { maximumFractionDigits: 0 }) + ' Kz'; }

// marcas presentes (com contagem)
var lsMarcasMap = {};
// (os resultados da pesquisa trazem só o nome da marca: o id vem da lista de marcas)
lsUniverso.forEach(function (p) {
    if (!p.brand || !p.brand.name) return;
    // na pesquisa a marca filtra-se pelo nome; na categoria pelo id
    var id = lsPesquisa ? p.brand.name : p.brand.id;
    if (!id) return;
    lsMarcasMap[id] = lsMarcasMap[id] || { id: id, name: p.brand.name, n: 0 };
    lsMarcasMap[id].n++;
});
var lsMarcas = Object.keys(lsMarcasMap).map(function (k) { return lsMarcasMap[k]; }).sort(function (a, b) { return b.n - a.n || a.name.localeCompare(b.name); });
var lsParamMarca = lsPesquisa ? 'marca' : 'brandId';
var lsMarcaSel = lsF[lsParamMarca] || null;
var lsMarcaAtiva = lsMarcaSel ? (lsMarcasMap[lsMarcaSel] || (__brands.find(function (b) { return b.id === lsMarcaSel; }) || { name: lsMarcaSel })) : null;
function lsMarcaUrl(v) { var o = { page: null }; o[lsParamMarca] = v; return lsUrl(o); }

// faixas de preço (só as que têm produtos)
var lsPreco = function (p) { return p.salePriceValue != null ? p.salePriceValue : p.basePriceValue; };
var lsFaixas = [
    { label: 'Até 25 000 Kz', min: '', max: 25000 },
    { label: '25 000 a 100 000 Kz', min: 25000, max: 100000 },
    { label: '100 000 a 300 000 Kz', min: 100000, max: 300000 },
    { label: 'Mais de 300 000 Kz', min: 300000, max: '' },
].map(function (f) {
    f.n = lsUniverso.filter(function (p) { var v = lsPreco(p); return (f.min === '' || v >= f.min) && (f.max === '' || v <= f.max); }).length;
    f.on = String(lsF.minPrice || '') === String(f.min) && String(lsF.maxPrice || '') === String(f.max);
    return f;
}).filter(function (f) { return f.n > 0; });

// categorias dos resultados (pesquisa) ou subcategorias (categoria)
var lsCats = [];
if (lsPesquisa && lsQ) {
    var m = {};
    lsUniverso.forEach(function (p) { if (p.categorySlug) { m[p.categorySlug] = m[p.categorySlug] || { slug: p.categorySlug, name: p.category, n: 0 }; m[p.categorySlug].n++; } });
    lsCats = Object.keys(m).map(function (k) { return m[k]; }).sort(function (a, b) { return b.n - a.n; }).slice(0, 10);
} else if (__category && __category.children && __category.children.length) {
    lsCats = __category.children.map(function (c) { return { slug: c.slug, name: c.name, n: (c._count && c._count.products) || 0, link: '/' + c.slug }; }).filter(function (c) { return c.n > 0; });
}

var lsOrdens = [
    { v: '', label: 'Relevância' },
    { v: 'newest', label: 'Mais recentes' },
    { v: 'price_asc', label: 'Preço mais baixo' },
    { v: 'price_desc', label: 'Preço mais alto' },
];
var lsAtivos = [];
if (lsF.categoria) lsAtivos.push({ label: (lsCats.find(function (c) { return c.slug === lsF.categoria; }) || { name: lsF.categoria }).name, url: lsUrl({ categoria: null, page: null }) });
if (lsMarcaAtiva) lsAtivos.push({ label: lsMarcaAtiva.name, url: lsMarcaUrl(null) });
if (lsF.minPrice || lsF.maxPrice) lsAtivos.push({ label: (lsF.minPrice ? lsKz(lsF.minPrice) : '0 Kz') + ' – ' + (lsF.maxPrice ? lsKz(lsF.maxPrice) : 'mais'), url: lsUrl({ minPrice: null, maxPrice: null }) });
var lsCatalogoTop = (typeof catalogo !== 'undefined' && catalogo ? catalogo : []).slice(0, 6);
%>
<main id="content" role="main" class="ls-main">
    <div class="container">

        <% if (lsPesquisa) { %>
        <!-- Pesquisa: barra grande -->
        <section class="ls-pesq">
            <form class="ls-pesq-form" action="/pesquisa" method="GET" role="search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" name="q" value="<%= lsQ %>" placeholder="O que procura? Ex: rato sem fios, switch 24 portas, HP" aria-label="Pesquisar produtos" autocomplete="off" <%= lsQ ? '' : 'autofocus' %>>
                <button type="submit" class="ls-pesq-btn">Pesquisar</button>
            </form>
            <% if (lsQ) { %>
            <p class="ls-pesq-res"><b class="ls-num" data-num="<%= lsTotal %>"><%= lsTotal %></b> <%= lsTotal === 1 ? 'resultado' : 'resultados' %> para <span class="ls-termo">"<%= lsQ %>"</span></p>
            <% } %>
        </section>
        <% } else { %>
        <div class="lj-topo ls-topo">
            <nav class="lj-trilho" aria-label="Caminho">
                <a href="/">Início</a><span class="sep">/</span>
                <% if (__category && __category.parent) { %><a href="/<%= __category.parent.slug %>"><%= __category.parent.name %></a><span class="sep">/</span><% } %>
                <span><%= __heading %></span>
            </nav>
            <h1 class="lj-titulo"><%= __heading %></h1>
            <p class="lj-sub"><%= lsTotal %> <%= lsTotal === 1 ? 'produto' : 'produtos' %></p>
        </div>
        <% } %>

        <% if (lsCats.length) { %>
        <div class="ls-chips" aria-label="<%= lsPesquisa ? 'Filtrar por categoria' : 'Subcategorias' %>">
            <% if (lsPesquisa) { %>
            <a href="<%= lsUrl({ categoria: null, page: null }) %>" class="ls-chip<%= !lsF.categoria ? ' on' : '' %>">Todas</a>
            <% } %>
            <% lsCats.forEach(function (c) { %>
            <a href="<%= c.link || lsUrl({ categoria: c.slug, page: null }) %>" class="ls-chip<%= lsF.categoria === c.slug ? ' on' : '' %>"><%= c.name %> <em><%= c.n %></em></a>
            <% }) %>
        </div>
        <% } %>

        <% if (!lsPesquisa || lsQ) { %>
        <div class="ls-corpo">
            <!-- Filtros -->
            <aside class="ls-filtros" id="lsFiltros" aria-label="Filtros">
                <div class="ls-filtros-topo">
                    <strong>Filtros</strong>
                    <button type="button" class="ls-fechar" data-ls-fechar aria-label="Fechar filtros"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
                </div>

                <% if (lsMarcas.length) { %>
                <div class="ls-bloco">
                    <p class="ls-bloco-tit">Marca</p>
                    <ul class="ls-opcoes<%= lsMarcas.length > 6 ? ' ls-longa' : '' %>">
                        <% lsMarcas.forEach(function (b, i) { var on = lsMarcaSel === b.id; %>
                        <li<%- i >= 6 ? ' class="ls-extra"' : '' %>><a href="<%= lsMarcaUrl(on ? null : b.id) %>" class="ls-opcao<%= on ? ' on' : '' %>" role="checkbox" aria-checked="<%= on %>"><span class="ls-caixa"></span><span class="ls-opcao-txt"><%= b.name %></span><em><%= b.n %></em></a></li>
                        <% }) %>
                    </ul>
                    <% if (lsMarcas.length > 6) { %><button type="button" class="ls-mais" data-ls-mais>Ver mais <%= lsMarcas.length - 6 %></button><% } %>
                </div>
                <% } %>

                <div class="ls-bloco">
                    <p class="ls-bloco-tit">Preço</p>
                    <ul class="ls-opcoes">
                        <% lsFaixas.forEach(function (f) { %>
                        <li><a href="<%= lsUrl(f.on ? { minPrice: null, maxPrice: null, page: null } : { minPrice: f.min, maxPrice: f.max, page: null }) %>" class="ls-opcao ls-radio<%= f.on ? ' on' : '' %>" role="radio" aria-checked="<%= f.on %>"><span class="ls-caixa"></span><span class="ls-opcao-txt"><%= f.label %></span><em><%= f.n %></em></a></li>
                        <% }) %>
                    </ul>
                    <form method="GET" class="ls-intervalo">
                        <% if (lsPesquisa && lsQ) { %><input type="hidden" name="q" value="<%= lsQ %>"><% } %>
                        <% if (lsF.categoria) { %><input type="hidden" name="categoria" value="<%= lsF.categoria %>"><% } %>
                        <% if (lsF.sort) { %><input type="hidden" name="sort" value="<%= lsF.sort %>"><% } %>
                        <% if (lsF.brandId) { %><input type="hidden" name="brandId" value="<%= lsF.brandId %>"><% } %>
                        <% if (lsF.marca) { %><input type="hidden" name="marca" value="<%= lsF.marca %>"><% } %>
                        <input type="number" min="0" name="minPrice" class="lj-input" placeholder="Mín." value="<%= lsF.minPrice || '' %>" aria-label="Preço mínimo">
                        <span>–</span>
                        <input type="number" min="0" name="maxPrice" class="lj-input" placeholder="Máx." value="<%= lsF.maxPrice || '' %>" aria-label="Preço máximo">
                        <button type="submit" class="ls-ir" aria-label="Aplicar preço"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
                    </form>
                </div>

                <% if (!lsPesquisa && __topProducts.length) { %>
                <div class="ls-bloco">
                    <p class="ls-bloco-tit">Acabados de chegar</p>
                    <% __topProducts.slice(0, 4).forEach(function (p) { %>
                    <a href="/<%= p.categorySlug %>/<%= p.urlKey %>" class="ls-mini">
                        <span class="ls-mini-foto"><% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } %></span>
                        <span class="ls-mini-txt"><span><%= p.name %></span><b><%= p.salePrice || p.basePrice %></b></span>
                    </a>
                    <% }) %>
                </div>
                <% } %>

                <div class="ls-filtros-pe">
                    <a href="<%= lsUrl({ brandId: null, marca: null, minPrice: null, maxPrice: null, categoria: null, page: null }) %>" class="lj-btn lj-btn-linha">Limpar</a>
                    <button type="button" class="lj-btn lj-btn-escuro" data-ls-fechar>Ver <%= lsTotal %> produtos</button>
                </div>
            </aside>
            <div class="ls-veu" data-ls-fechar></div>

            <!-- Resultados -->
            <section class="ls-res">
                <div class="ls-barra">
                    <button type="button" class="ls-btn-filtros" data-ls-abrir>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
                        Filtros<% if (lsAtivos.length) { %> <em><%= lsAtivos.length %></em><% } %>
                    </button>
                    <div class="ls-ordem" role="tablist" aria-label="Ordenar">
                        <% lsOrdens.forEach(function (o) { var on = (lsF.sort || '') === o.v; %>
                        <a href="<%= lsUrl({ sort: o.v || null, page: null }) %>" class="ls-ordem-op<%= on ? ' on' : '' %>" role="tab" aria-selected="<%= on %>"><%= o.label %></a>
                        <% }) %>
                    </div>
                    <select class="ls-ordem-sel lj-input" aria-label="Ordenar" onchange="location.href=this.value">
                        <% lsOrdens.forEach(function (o) { %><option value="<%= lsUrl({ sort: o.v || null, page: null }) %>" <%= (lsF.sort || '') === o.v ? 'selected' : '' %>><%= o.label %></option><% }) %>
                    </select>
                </div>

                <% if (lsAtivos.length) { %>
                <div class="ls-ativos">
                    <% lsAtivos.forEach(function (a) { %>
                    <a href="<%= a.url %>" class="ls-ativo"><%= a.label %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></a>
                    <% }) %>
                    <a href="<%= lsUrl({ brandId: null, marca: null, minPrice: null, maxPrice: null, categoria: null, page: null }) %>" class="ls-limpar">Limpar tudo</a>
                </div>
                <% } %>

                <% if (__products.length) { %>
                <ul class="ls-grelha">
                    <% __products.forEach(function (product, i) { %>
                    <%- include('partials/_cartao-produto', { product: product, i: i }) %>
                    <% }) %>
                </ul>
                <% } else { %>
                <div class="ls-vazio">
                    <div class="ls-vazio-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8.5 11h5"/></svg></div>
                    <strong><%= lsPesquisa ? 'Não encontrámos "' + lsQ + '"' : 'Sem produtos com estes filtros' %></strong>
                    <span><%= lsPesquisa ? 'Verifique a ortografia ou use palavras mais gerais (ex: "rato" em vez do modelo exato).' : 'Experimente retirar algum filtro.' %></span>
                    <% if (lsAtivos.length) { %><a href="<%= lsUrl({ brandId: null, marca: null, minPrice: null, maxPrice: null, categoria: null, page: null }) %>" class="lj-btn lj-btn-escuro" style="margin-top:14px;">Limpar filtros</a><% } %>
                    <% if (lsCatalogoTop.length) { %>
                    <p class="ls-vazio-sub">Ou explore uma categoria</p>
                    <div class="ls-chips ls-chips-centro">
                        <% lsCatalogoTop.forEach(function (c) { %><a href="/<%= c.slug %>" class="ls-chip"><%= c.name %> <em><%= c.count %></em></a><% }) %>
                    </div>
                    <% } %>
                </div>
                <% } %>

                <% if (__pagination && __pagination.pages > 1) { %>
                <nav class="ls-paginas" aria-label="Páginas">
                    <% if (__pagination.page > 1) { %><a href="<%= lsUrl({ page: __pagination.page - 1 }) %>" class="ls-pag" aria-label="Página anterior">‹</a><% } %>
                    <% for (let i = 1; i <= __pagination.pages; i++) { %>
                    <a href="<%= lsUrl({ page: i }) %>" class="ls-pag<%= __pagination.page === i ? ' on' : '' %>"<%- __pagination.page === i ? ' aria-current="page"' : '' %>><%= i %></a>
                    <% } %>
                    <% if (__pagination.page < __pagination.pages) { %><a href="<%= lsUrl({ page: __pagination.page + 1 }) %>" class="ls-pag" aria-label="Página seguinte">›</a><% } %>
                </nav>
                <% } %>
            </section>
        </div>
        <% } else { %>
        <!-- Pesquisa vazia: sugestões -->
        <section class="ls-sugestoes">
            <p class="ls-sug-tit">Categorias populares</p>
            <div class="ls-sug-grelha">
                <% lsCatalogoTop.forEach(function (c, i) { %>
                <a href="/<%= c.slug %>" class="ls-sug" style="--i:<%= i %>">
                    <span class="ls-sug-img"><% if (c.image) { %><img src="<%= c.image %>" alt="" loading="lazy"><% } %></span>
                    <span><b><%= c.name %></b><small><%= c.count %> <%= c.count === 1 ? 'produto' : 'produtos' %></small></span>
                </a>
                <% }) %>
            </div>
            <p class="ls-sug-tit">Experimente procurar</p>
            <div class="ls-chips">
                <% ['rato sem fios', 'teclado', 'switch', 'access point', 'monitor', 'câmara', 'cabo de rede', 'mochila'].forEach(function (t) { %>
                <a href="/pesquisa?q=<%= encodeURIComponent(t) %>" class="ls-chip"><%= t %></a>
                <% }) %>
            </div>
        </section>
        <% } %>
    </div>
</main>

<%- include('partials/_footer') %>

<script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
<script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
<script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
<script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
<script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
<script src="/assets/vendor/slick-carousel/slick/slick.js"></script>
<script src="/assets/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
<script src="/assets/js/hs.core.js"></script>
<script src="/assets/js/components/hs.header.js"></script>
<script src="/assets/js/components/hs.hamburgers.js"></script>
<script src="/assets/js/components/hs.unfold.js"></script>
<script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
<script src="/assets/js/components/hs.slick-carousel.js"></script>
<script src="/assets/js/components/hs.svg-injector.js"></script>
<script src="/assets/js/components/hs.selectpicker.js"></script>
<script>
$(window).on('load', function () {
    $('.js-mega-menu').HSMegaMenu({
        event: 'hover',
        direction: 'horizontal',
        pageContainer: $('.container'),
        breakpoint: 767.98,
        hideTimeOut: 0
    });
    $.HSCore.components.HSSVGIngector.init('.js-svg-injector');
});

