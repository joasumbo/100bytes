<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <title>Rastrear Encomenda | 100bytes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="https://cdn.100bytes.co.ao/logo/100byte_fav.png">
    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
    <link rel="stylesheet" href="/css/loja.css">
    <style>
        .lj-procura { display:flex; gap:10px; padding:12px; max-width:640px; }
        .lj-procura .lj-input { height:48px; font-size:16px; letter-spacing:.04em; text-transform:uppercase; }
        .lj-procura .lj-input::placeholder { text-transform:none; letter-spacing:0; }
        @media (max-width:575.98px) { .lj-procura { flex-direction:column; } }
    </style>
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
</head>
<body class="lj">
<%- include('partials/_header-compacto') %>

<main id="content" role="main" class="lj-main">
<div class="container">

    <div class="lj-topo">
        <nav class="lj-trilho" aria-label="Caminho"><a href="/">Início</a><span class="sep">/</span><span>Seguir encomenda</span></nav>
        <h1 class="lj-titulo">Seguir encomenda</h1>
        <p class="lj-sub">Escreva o código que recebeu ao fazer a encomenda (por exemplo 100B-ABC123).</p>
    </div>

    <form class="lj-card lj-procura" action="/rastreio" method="GET" onsubmit="doTrack(event)">
        <label for="trackInput" class="sr-only">Código da encomenda</label>
        <input id="trackInput" class="lj-input" type="text" name="c" placeholder="Código da encomenda"
            value="<%= typeof code !== 'undefined' ? code : '' %>" autocomplete="off" spellcheck="false" autocapitalize="characters">
        <button type="submit" class="lj-btn lj-btn-escuro">Procurar</button>
    </form>

    <% if (searched && !order) { %>
    <div class="lj-card" style="margin-top:16px;">
        <div class="lj-nota">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span><strong>Não encontrámos a encomenda <%= code %></strong>Confirme se o código está bem escrito. Se precisar de ajuda, ligue para <a href="tel:+244928499325" style="color:inherit;text-decoration:underline;">928 499 325</a>.</span>
        </div>
    </div>

    <% } else if (order) { %>
    <%
    var rtEstados = { pending:'Aguarda confirmação', confirmed:'Confirmada', preparing:'Em preparação', processing:'Em preparação', shipped:'A caminho', delivered:'Entregue', cancelled:'Cancelada' };
    %>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:28px 0 16px;">
        <div>
            <h2 class="lj-sec" style="margin:0 0 4px;">Encomenda <%= order.code %></h2>
            <div style="font-size:14px;color:var(--lj-suave);">Feita a <%= new Date(order.createdAt).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
        </div>
        <span class="lj-estado <%= order.status %>"><%= rtEstados[order.status] || order.status %></span>
    </div>
    <%- include('partials/_encomenda-detalhe', { order: order, ejAcoes: '<div style="margin-top:16px;"><a href="/" class="lj-btn lj-btn-linha lj-btn-bloco">Continuar a comprar</a></div>' }) %>
    <% } %>

</div>
</main>

<%- include('partials/_footer') %>

<script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
<script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
<script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
<script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
<script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
<script src="/assets/js/hs.core.js"></script>
<script src="/assets/js/components/hs.header.js"></script>
<script src="/assets/js/components/hs.hamburgers.js"></script>
<script src="/assets/js/components/hs.unfold.js"></script>
<script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
<script src="/assets/js/components/hs.svg-injector.js"></script>
<script src="/assets/js/customer-auth.js"></script>
<script>
$(window).on('load', function () {
    $('.js-mega-menu').HSMegaMenu({ event:'hover', direction:'horizontal', pageContainer:$('.container'), breakpoint:767.98, hideTimeOut:0 });
    $.HSCore.components.HSSVGIngector && $.HSCore.components.HSSVGIngector.init('.js-svg-injector');
});
$(document).ready(function () {
    $.HSCore.components.HSHeader.init($('#header'));
    $.HSCore.components.HSHamburgers.init('.hamburger');
    $.HSCore.components.HSUnfold.init($('[data-unfold-target]'), {
        afterOpen: function () { $(this).find('input[type="search"]').focus(); }
    });
    $.HSCore.components.HSMalihuScrollBar.init($('.js-scrollbar'));
});

function doTrack(e) {
    e.preventDefault();
    var val = document.getElementById('trackInput').value.trim().toUpperCase();
    if (!val) return;
    window.location.href = '/rastreio/' + encodeURIComponent(val);
}
</script>
    <script src="/js/precos.js" defer></script>
    <script src="/js/comportamento.js" defer></script>
    <script src="/js/pesquisa.js" defer></script>
</body>
</html>
