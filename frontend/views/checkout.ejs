<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <title>Checkout | 100bytes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="https://cdn.100bytes.co.ao/logo/100byte_fav.png">
    <link rel="icon" type="image/png" href="https://cdn.100bytes.co.ao/logo/100byte_fav.png">
    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/css/theme.css">

    <link rel="stylesheet" href="/css/loja.css">
    <style>
        .co-spinner { display:inline-block; width:18px; height:18px; border:2px solid rgba(255,255,255,.4); border-top-color:#fff; border-radius:50%; animation:coGira .7s linear infinite; }
        @keyframes coGira { to { transform:rotate(360deg); } }
    </style>
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/fonte.css">
</head>
<body class="lj">

<%- include('partials/_header-compacto') %>

<main id="content" role="main" class="lj-main">
    <div class="container">

        <div class="lj-topo">
            <nav class="lj-trilho" aria-label="Caminho"><a href="/">Início</a><span class="sep">/</span><span>Finalizar encomenda</span></nav>
            <h1 class="lj-titulo">Finalizar encomenda</h1>
            <p class="lj-sub">Indique os seus dados. Confirmamos a encomenda consigo por telefone ou WhatsApp antes de a preparar.</p>
        </div>

        <% if (!currentCustomer) { %>
        <div class="lj-aviso">
            <span>Já tem conta? <a href="#" onclick="if(window.customerAuth)window.customerAuth.showLoginModal();return false;">Inicie sessão</a> para preencher os dados automaticamente e acompanhar as suas encomendas.</span>
        </div>
        <% } %>

        <div class="lj-duas">

            <form id="checkoutForm" novalidate>
                <section class="lj-card">
                    <h2 class="lj-sec"><span class="lj-num">1</span>Contacto</h2>
                    <div class="lj-grelha">
                        <div class="lj-campo lj-larga">
                            <label for="co_name">Nome completo</label>
                            <input type="text" id="co_name" name="name" class="lj-input" placeholder="Ex: João Silva" autocomplete="name">
                            <div class="lj-erro-txt" id="err_name">Indique o seu nome.</div>
                        </div>
                        <div class="lj-campo">
                            <label for="co_email">Email</label>
                            <input type="email" id="co_email" name="email" class="lj-input" placeholder="email@exemplo.com" autocomplete="email">
                            <div class="lj-erro-txt" id="err_email">Indique um email válido.</div>
                        </div>
                        <div class="lj-campo">
                            <label for="co_phone">Telefone</label>
                            <input type="tel" id="co_phone" name="phone" class="lj-input" placeholder="+244 9xx xxx xxx" autocomplete="tel">
                            <div class="lj-erro-txt" id="err_phone">Indique um número de telefone.</div>
                        </div>
                    </div>
                </section>

                <section class="lj-card">
                    <h2 class="lj-sec"><span class="lj-num">2</span>Entrega</h2>
                    <div class="lj-grelha">
                        <div class="lj-campo">
                            <label for="co_province">Província</label>
                            <select id="co_province" name="province" class="lj-input">
                                <option value="">Selecionar</option>
                                <% ["Bengo","Benguela","Bié","Cabinda","Cuando Cubango","Cuanza Norte","Cuanza Sul","Cunene","Huambo","Huíla","Luanda","Lunda Norte","Lunda Sul","Malanje","Moxico","Namibe","Uíge","Zaire"].forEach(function (p) { %>
                                <option value="<%= p %>"><%= p %></option>
                                <% }) %>
                            </select>
                            <div class="lj-erro-txt" id="err_province">Escolha a província.</div>
                        </div>
                        <div class="lj-campo">
                            <label for="co_city">Município</label>
                            <input type="text" id="co_city" name="city" class="lj-input" placeholder="Ex: Luanda, Viana, Talatona" autocomplete="address-level2">
                            <div class="lj-erro-txt" id="err_city">Indique o município.</div>
                        </div>
                        <div class="lj-campo lj-larga">
                            <label for="co_address">Morada</label>
                            <input type="text" id="co_address" name="address" class="lj-input" placeholder="Rua, número, bairro e um ponto de referência" autocomplete="street-address">
                            <div class="lj-erro-txt" id="err_address">Indique a morada de entrega.</div>
                        </div>
                        <div class="lj-campo lj-larga">
                            <label for="co_notes">Notas <span class="opc">(opcional)</span></label>
                            <textarea id="co_notes" name="notes" class="lj-input" rows="3" placeholder="Horário preferido, instruções para o estafeta, etc."></textarea>
                        </div>
                    </div>
                </section>

                <section class="lj-card">
                    <h2 class="lj-sec"><span class="lj-num">3</span>Pagamento</h2>
                    <div class="lj-nota">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                        <span><strong>Paga só depois da confirmação</strong>Quando confirmarmos a encomenda e o custo de entrega, indicamos como pagar.</span>
                    </div>
                </section>
            </form>

            <aside class="lj-fixo">
                <section class="lj-card">
                    <h2 class="lj-sec">Resumo</h2>

                    <div class="lj-vazio" id="coEmpty">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        <div>O carrinho está vazio.</div>
                        <a href="/">Ver produtos</a>
                    </div>

                    <div id="coItems" style="display:none;">
                        <div id="coItemsList"></div>
                        <div class="lj-totais">
                            <div class="lj-linha"><span>Subtotal</span><b id="coSubtotal">0,00 Kz</b></div>
                            <div class="lj-linha"><span>Entrega</span><b>Confirmada depois</b></div>
                            <div class="lj-linha total"><span>Total</span><b id="coTotal">0,00 Kz</b></div>
                        </div>
                        <button type="submit" form="checkoutForm" class="lj-btn lj-btn-marca lj-btn-bloco" id="btnConfirm" style="margin-top:20px;">Confirmar encomenda</button>
                    </div>
                </section>

                <section class="lj-card">
                    <div class="lj-nota">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                        <span><strong>Entrega em todo o país</strong>O prazo e o custo são confirmados consigo depois da encomenda.</span>
                    </div>
                    <div class="lj-nota">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                        <span><strong>Devolução em até 7 dias</strong>Para trocar de produto.</span>
                    </div>
                    <div class="lj-nota">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg>
                        <span><strong>Assistência técnica própria</strong>Na loja da Liga Africana, em Luanda.</span>
                    </div>
                </section>
            </aside>

        </div>
    </div>
</main>

<%- include('partials/_footer') %>

<script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
<script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
<script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
<script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
<script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
<script src="/assets/js/hs.core.js"></script>
<script src="/assets/js/components/hs.header.js"></script>
<script src="/assets/js/components/hs.hamburgers.js"></script>
<script src="/assets/js/components/hs.unfold.js"></script>
<script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
<script src="/assets/js/components/hs.svg-injector.js"></script>

<script>
$(window).on('load', function () {
    $('.js-mega-menu').HSMegaMenu({ event:'hover', direction:'horizontal', pageContainer:$('.container'), breakpoint:767.98, hideTimeOut:0 });
    $.HSCore.components.HSSVGIngector.init('.js-svg-injector');
});
$(document).ready(function () {
    $.HSCore.components.HSHeader.init($('#header'));
    $.HSCore.components.HSHamburgers.init('.hamburger');
    $.HSCore.components.HSUnfold.init($('[data-unfold-target]'), {
        afterOpen: function () { $(this).find('input[type="search"]').focus(); }
    });
    $.HSCore.components.HSMalihuScrollBar.init($('.js-scrollbar'));
});
</script>

<script>
(function () {
    'use strict';

    var CART_KEY = 'cart100_items';

    function getCart() {
        try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch (e) { return []; }
    }

    function formatPrice(value) {
        return value.toLocaleString('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
    }

    function escHtml(str) {
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Render cart summary ──────────────────────────────────────────
    function renderSummary() {
        var cart = getCart();
        var empty = document.getElementById('coEmpty');
        var items = document.getElementById('coItems');
        var btn   = document.getElementById('btnConfirm');

        if (!cart.length) {
            empty.style.display = 'block';
            items.style.display = 'none';
            if (btn) btn.disabled = true;
            return;
        }

        empty.style.display = 'none';
        items.style.display = 'block';
        if (btn) btn.disabled = false;

        var subtotal = cart.reduce(function (s, i) { return s + (i.price * i.qty); }, 0);

        var html = cart.map(function (item) {
            var foto = item.image ? '<img src="' + escHtml(item.image) + '" alt="" onerror="this.remove()">' : '';
            return '<div class="lj-item">'
                + '<div class="lj-item-foto">' + foto + '<span class="lj-item-qtd">' + item.qty + '</span></div>'
                + '<div class="lj-item-txt"><div class="lj-item-nome">' + escHtml(item.name) + '</div>'
                + (item.qty > 1 ? '<div class="lj-item-uni">' + item.qty + ' × ' + formatPrice(item.price) + '</div>' : '') + '</div>'
                + '<div class="lj-item-preco">' + formatPrice(item.price * item.qty) + '</div>'
                + '</div>';
        }).join('');

        document.getElementById('coItemsList').innerHTML = html;
        document.getElementById('coSubtotal').textContent = formatPrice(subtotal);
        document.getElementById('coTotal').textContent = formatPrice(subtotal);
    }

    // ── Pre-fill form ────────────────────────────────────────────────
    function prefillFromServer() {
        // Server-side data from JWT (name + email)
        <% if (currentCustomer) { %>
        setVal('co_name',  '<%- (currentCustomer.name  || '').replace(/'/g, "\\'") %>');
        setVal('co_email', '<%- (currentCustomer.email || '').replace(/'/g, "\\'") %>');
        <% } %>
    }

    function setVal(id, val) {
        var el = document.getElementById(id);
        if (el && val) el.value = val;
    }

    function prefillFromApi() {
        fetch('/api/customers/me', { credentials: 'include' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data || !data.customer) return;
                var c = data.customer;
                setVal('co_name',  c.name);
                setVal('co_email', c.email);
                setVal('co_phone', c.phone);
                setVal('co_city', c.city);
                setVal('co_address', c.address);
                if (c.province) { var pv = document.getElementById('co_province'); if (pv && !pv.value) pv.value = c.province; }
            })
            .catch(function () {});
    }

    // ── Validation ───────────────────────────────────────────────────
    function showErr(id, show) {
        var el = document.getElementById('err_' + id);
        var input = document.getElementById('co_' + id);
        if (!el || !input) return;
        el.classList.toggle('show', show);
        input.classList.toggle('is-invalid', show);
    }

    function validate() {
        var ok = true;
        var name    = (document.getElementById('co_name').value   || '').trim();
        var email   = (document.getElementById('co_email').value  || '').trim();
        var phone   = (document.getElementById('co_phone').value  || '').trim();
        var prov    = (document.getElementById('co_province').value || '').trim();
        var city    = (document.getElementById('co_city').value   || '').trim();
        var address = (document.getElementById('co_address').value || '').trim();

        if (!name)    { showErr('name',     true); ok = false; } else showErr('name',     false);
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('email', true); ok = false; } else showErr('email', false);
        if (!phone)   { showErr('phone',    true); ok = false; } else showErr('phone',    false);
        if (!prov)    { showErr('province', true); ok = false; } else showErr('province', false);
        if (!city)    { showErr('city',     true); ok = false; } else showErr('city',     false);
        if (!address) { showErr('address',  true); ok = false; } else showErr('address',  false);

        return ok;
    }

    // ── Submit ───────────────────────────────────────────────────────
    function handleSubmit(e) {
        e.preventDefault();
        if (!validate()) {
            document.querySelector('.is-invalid').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        var cart = getCart();
        if (!cart.length) return;

        var btn = document.getElementById('btnConfirm');
        btn.disabled = true;
        btn.innerHTML = '<span class="co-spinner"></span> A enviar…';

        var payload = {
            customer: {
                name:    document.getElementById('co_name').value.trim(),
                email:   document.getElementById('co_email').value.trim(),
                phone:   document.getElementById('co_phone').value.trim(),
            },
            delivery: {
                province: document.getElementById('co_province').value.trim(),
                city:     document.getElementById('co_city').value.trim(),
                address:  document.getElementById('co_address').value.trim(),
                notes:    document.getElementById('co_notes').value.trim(),
            },
            items: cart.map(function (i) {
                return { productId: i.id, name: i.name, qty: i.qty, price: i.price, priceFormatted: i.priceFormatted || '', image: i.image || '' };
            }),
        };

        fetch('/api/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Session-Id': (window.bbSessionId ? window.bbSessionId() : '') },
            credentials: 'include',
            body: JSON.stringify(payload),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            if (res.ok && res.data.code) {
                localStorage.removeItem(CART_KEY);
                window.location.href = '/encomenda/' + res.data.code;
            } else {
                btn.disabled = false;
                btn.innerHTML = 'Confirmar encomenda';
                window.ui.toast(res.data.message || 'Erro ao processar encomenda. Tente novamente.', { type: 'error' });
            }
        })
        .catch(function () {
            btn.disabled = false;
            btn.innerHTML = 'Confirmar encomenda';
            window.ui.toast('Erro de ligação. Verifique a sua internet e tente novamente.', { type: 'error' });
        });
    }

    // ── Init ─────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        renderSummary();
        prefillFromServer();
        prefillFromApi();

        var form = document.getElementById('checkoutForm');
        if (form) form.addEventListener('submit', handleSubmit);

        // Real-time clear errors on input
        ['co_name','co_email','co_phone','co_province','co_city','co_address'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('input', function () {
                el.classList.remove('is-invalid');
                var fieldName = id.replace('co_', '');
                var err = document.getElementById('err_' + fieldName);
                if (err) err.classList.remove('show');
            });
        });
    });

})();
</script>

    <script src="/js/precos.js" defer></script>
    <script src="/js/comportamento.js" defer></script>
    <script src="/js/pesquisa.js" defer></script>
</body>
</html>
