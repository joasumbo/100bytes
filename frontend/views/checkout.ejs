<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <title>Checkout | 100bytes</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="shortcut icon" href="https://cdn100ka.sysvenus.com/logo/100byte_fav.png">
    <link rel="icon" type="image/png" href="https://cdn100ka.sysvenus.com/logo/100byte_fav.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/vendor/font-awesome/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="/assets/css/font-electro.css">
    <link rel="stylesheet" href="/assets/vendor/animate.css/animate.min.css">
    <link rel="stylesheet" href="/assets/vendor/hs-megamenu/src/hs.megamenu.css">
    <link rel="stylesheet" href="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.css">
    <link rel="stylesheet" href="/assets/css/theme.css">

    <style>
        :root { --brand: #F57C00; --brand-dark: #D96A00; }

        .btn-primary,
        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary:not(:disabled):not(.disabled):active {
            background-color: var(--brand) !important;
            border-color: var(--brand) !important;
        }
        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--brand-dark) !important;
            border-color: var(--brand-dark) !important;
        }
        .text-primary { color: var(--brand) !important; }
        .bg-primary { background-color: var(--brand) !important; }
        .u-header-topbar { background-color: #ffffff !important; border-bottom: 1px solid #e6e6e6; }
        .bg-primary-down-lg { background-color: #ffffff !important; }
        .u-header-topbar .topbar-left a,
        .u-header-topbar .u-header-topbar__nav-link,
        .u-header-topbar .dropdown-nav-link { color: #2f2f33 !important; }
        .u-header-topbar .u-header-topbar__nav-item-border::after { border-color: rgba(47,47,51,.28) !important; }
        .u-header .form-control, .u-header .form-control::placeholder { color: #5f636b !important; font-weight: 600; }

        body { background: #f5f5f5; }

        /* ── Cards ── */
        .co-card {
            background: #fff;
            border: 1px solid #e8e8e8;
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
        }
        .co-card-title {
            font-size: 15px;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--brand);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .co-card-title i { color: var(--brand); font-size: 16px; }

        /* ── Form ── */
        .co-label {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            margin-bottom: 5px;
            display: block;
            text-transform: uppercase;
            letter-spacing: .4px;
        }
        .co-input {
            width: 100%;
            border: 1px solid #d8dde6;
            border-radius: 7px;
            padding: 10px 13px;
            font-size: 14px;
            color: #1a1a2e;
            background: #fff;
            transition: border-color .15s, box-shadow .15s;
            outline: none;
        }
        .co-input:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(245,124,0,.12);
        }
        .co-input.is-invalid { border-color: #e53935; }
        .co-err { font-size: 11px; color: #e53935; margin-top: 3px; display: none; }
        .co-err.show { display: block; }
        .co-form-group { margin-bottom: 16px; }

        /* ── Order summary items ── */
        .co-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #f2f2f2;
        }
        .co-item:last-child { border-bottom: 0; }
        .co-item-img {
            width: 56px;
            height: 56px;
            border: 1px solid #eee;
            border-radius: 7px;
            object-fit: contain;
            background: #fafafa;
            flex-shrink: 0;
        }
        .co-item-name {
            flex: 1;
            font-size: 12px;
            font-weight: 500;
            color: #333;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .co-item-qty { font-size: 11px; color: #999; margin-top: 2px; }
        .co-item-price { font-size: 13px; font-weight: 700; color: var(--brand); white-space: nowrap; }

        /* ── Totals ── */
        .co-totals { margin-top: 14px; }
        .co-total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: #555;
            margin-bottom: 8px;
        }
        .co-total-row.total-final {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
            padding-top: 10px;
            border-top: 2px solid #f0f0f0;
            margin-top: 4px;
        }
        .co-total-row .val { font-weight: 600; color: #1a1a2e; }
        .co-total-row.total-final .val { color: var(--brand); }

        /* ── Confirm button ── */
        .co-confirm-btn {
            display: block;
            width: 100%;
            padding: 14px;
            background: var(--brand);
            color: #fff;
            border: 0;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
            transition: background .2s;
            margin-top: 16px;
        }
        .co-confirm-btn:hover { background: var(--brand-dark); }
        .co-confirm-btn:disabled { background: #ccc; cursor: not-allowed; }

        /* ── Empty cart ── */
        .co-empty {
            text-align: center;
            padding: 40px 20px;
        }
        .co-empty i { font-size: 48px; color: #ddd; margin-bottom: 12px; display: block; }
        .co-empty p { font-size: 14px; color: #999; margin-bottom: 16px; }
        .co-empty a { color: var(--brand); font-weight: 600; text-decoration: none; }

        /* ── Login notice ── */
        .co-login-notice {
            background: #fff8f0;
            border: 1px solid #ffe0b2;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 13px;
            color: #555;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .co-login-notice i { color: var(--brand); font-size: 16px; flex-shrink: 0; }
        .co-login-notice a { color: var(--brand); font-weight: 600; }

        /* ── Spinner ── */
        .co-spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
            vertical-align: middle;
            margin-right: 6px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Sticky summary on mobile ── */
        @media (max-width: 991.98px) {
            .co-summary-sticky { position: static; }
        }
        @media (min-width: 992px) {
            .co-summary-sticky { position: sticky; top: 20px; }
        }
    </style>
</head>
<body>

<%- include('partials/_header') %>

<main id="content" role="main" class="py-5">
    <div class="container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb breadcrumb-no-gutter font-size-12">
                <li class="breadcrumb-item"><a href="/">Início</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <h1 class="font-size-22 font-weight-bold mb-4" style="color:#1a1a2e;">Finalizar Encomenda</h1>

        <!-- Login notice (only for guests) -->
        <% if (!currentCustomer) { %>
        <div class="co-login-notice">
            <i class="fas fa-info-circle"></i>
            <span>Tem conta? <a href="#" onclick="if(window.customerAuth)window.customerAuth.showLoginModal();return false;">Inicie sessão</a> para pré-preencher os seus dados e acompanhar a encomenda.</span>
        </div>
        <% } %>

        <div class="row">

            <!-- ── LEFT: Form ── -->
            <div class="col-lg-7 mb-4">

                <form id="checkoutForm" novalidate>

                    <!-- Dados de entrega -->
                    <div class="co-card">
                        <div class="co-card-title">
                            <i class="fas fa-map-marker-alt"></i> Dados de Entrega
                        </div>

                        <div class="row">
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_name">Nome completo *</label>
                                <input type="text" id="co_name" name="name" class="co-input" placeholder="Ex: João Silva" autocomplete="name">
                                <div class="co-err" id="err_name">Campo obrigatório</div>
                            </div>
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_email">Email *</label>
                                <input type="email" id="co_email" name="email" class="co-input" placeholder="email@exemplo.com" autocomplete="email">
                                <div class="co-err" id="err_email">Email inválido</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_phone">Telefone *</label>
                                <input type="tel" id="co_phone" name="phone" class="co-input" placeholder="+244 9xx xxx xxx" autocomplete="tel">
                                <div class="co-err" id="err_phone">Campo obrigatório</div>
                            </div>
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_province">Província *</label>
                                <select id="co_province" name="province" class="co-input">
                                    <option value="">Selecionar província</option>
                                    <option value="Bengo">Bengo</option>
                                    <option value="Benguela">Benguela</option>
                                    <option value="Bié">Bié</option>
                                    <option value="Cabinda">Cabinda</option>
                                    <option value="Cuando Cubango">Cuando Cubango</option>
                                    <option value="Cuanza Norte">Cuanza Norte</option>
                                    <option value="Cuanza Sul">Cuanza Sul</option>
                                    <option value="Cunene">Cunene</option>
                                    <option value="Huambo">Huambo</option>
                                    <option value="Huíla">Huíla</option>
                                    <option value="Luanda">Luanda</option>
                                    <option value="Lunda Norte">Lunda Norte</option>
                                    <option value="Lunda Sul">Lunda Sul</option>
                                    <option value="Malanje">Malanje</option>
                                    <option value="Moxico">Moxico</option>
                                    <option value="Namibe">Namibe</option>
                                    <option value="Uíge">Uíge</option>
                                    <option value="Zaire">Zaire</option>
                                </select>
                                <div class="co-err" id="err_province">Selecione uma província</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_city">Município / Cidade *</label>
                                <input type="text" id="co_city" name="city" class="co-input" placeholder="Ex: Luanda, Viana, Cacuaco">
                                <div class="co-err" id="err_city">Campo obrigatório</div>
                            </div>
                            <div class="col-sm-6 co-form-group">
                                <label class="co-label" for="co_address">Morada *</label>
                                <input type="text" id="co_address" name="address" class="co-input" placeholder="Rua, número, bairro">
                                <div class="co-err" id="err_address">Campo obrigatório</div>
                            </div>
                        </div>
                    </div>

                    <!-- Observações -->
                    <div class="co-card">
                        <div class="co-card-title">
                            <i class="far fa-comment-alt"></i> Observações
                        </div>
                        <div class="co-form-group mb-0">
                            <label class="co-label" for="co_notes">Notas adicionais (opcional)</label>
                            <textarea id="co_notes" name="notes" class="co-input" rows="3" placeholder="Instruções especiais, referência de entrega, etc."></textarea>
                        </div>
                    </div>

                </form>
            </div>

            <!-- ── RIGHT: Order summary ── -->
            <div class="col-lg-5">
                <div class="co-summary-sticky">
                    <div class="co-card">
                        <div class="co-card-title">
                            <i class="ec ec-shopping-bag"></i> Resumo da Encomenda
                        </div>

                        <!-- Empty state (hidden when cart has items) -->
                        <div class="co-empty" id="coEmpty">
                            <i class="ec ec-shopping-bag"></i>
                            <p>O seu carrinho está vazio.</p>
                            <a href="/">Ver produtos</a>
                        </div>

                        <!-- Items list -->
                        <div id="coItems" style="display:none;">
                            <div id="coItemsList"></div>

                            <div class="co-totals">
                                <div class="co-total-row">
                                    <span>Subtotal</span>
                                    <span class="val" id="coSubtotal">0,00 Kz</span>
                                </div>
                                <div class="co-total-row">
                                    <span>Entrega</span>
                                    <span class="val" style="color:#2e7d32;font-size:12px;">A calcular</span>
                                </div>
                                <div class="co-total-row total-final">
                                    <span>Total</span>
                                    <span class="val" id="coTotal">0,00 Kz</span>
                                </div>
                            </div>

                            <button type="submit" form="checkoutForm" class="co-confirm-btn" id="btnConfirm">
                                Confirmar encomenda &rarr;
                            </button>

                            <p class="text-center mt-2 mb-0" style="font-size:11px;color:#aaa;">
                                <i class="fas fa-lock mr-1"></i> Os seus dados estão protegidos
                            </p>
                        </div>
                    </div>

                    <!-- Delivery info card -->
                    <div class="co-card" style="padding:16px;">
                        <div style="display:flex;gap:12px;align-items:flex-start;">
                            <i class="fas fa-truck" style="color:var(--brand);font-size:20px;flex-shrink:0;margin-top:2px;"></i>
                            <div>
                                <div style="font-size:13px;font-weight:700;color:#1a1a2e;margin-bottom:2px;">Entrega em Angola</div>
                                <div style="font-size:12px;color:#666;line-height:1.5;">Entregas em dias úteis. O prazo e custo serão confirmados após a encomenda.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<%- include('partials/_footer') %>

<script src="/assets/vendor/jquery/dist/jquery.min.js"></script>
<script src="/assets/vendor/jquery-migrate/dist/jquery-migrate.min.js"></script>
<script src="/assets/vendor/popper.js/dist/umd/popper.min.js"></script>
<script src="/assets/vendor/bootstrap/bootstrap.min.js"></script>
<script src="/assets/vendor/hs-megamenu/src/hs.megamenu.js"></script>
<script src="/assets/vendor/svg-injector/dist/svg-injector.min.js"></script>
<script src="/assets/vendor/malihu-custom-scrollbar-plugin/jquery.mCustomScrollbar.concat.min.js"></script>
<script src="/assets/js/hs.core.js"></script>
<script src="/assets/js/components/hs.header.js"></script>
<script src="/assets/js/components/hs.hamburgers.js"></script>
<script src="/assets/js/components/hs.unfold.js"></script>
<script src="/assets/js/components/hs.malihu-scrollbar.js"></script>
<script src="/assets/js/components/hs.svg-injector.js"></script>

<script>
$(window).on('load', function () {
    $('.js-mega-menu').HSMegaMenu({ event:'hover', direction:'horizontal', pageContainer:$('.container'), breakpoint:767.98, hideTimeOut:0 });
    $.HSCore.components.HSSVGIngector.init('.js-svg-injector');
});
$(document).ready(function () {
    $.HSCore.components.HSHeader.init($('#header'));
    $.HSCore.components.HSHamburgers.init('.hamburger');
    $.HSCore.components.HSUnfold.init($('[data-unfold-target]'), {
        afterOpen: function () { $(this).find('input[type="search"]').focus(); }
    });
    $.HSCore.components.HSMalihuScrollBar.init($('.js-scrollbar'));
});
</script>

<script>
(function () {
    'use strict';

    var CART_KEY = 'cart100_items';

    function getCart() {
        try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch (e) { return []; }
    }

    function formatPrice(value) {
        return value.toLocaleString('pt-PT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
    }

    function escHtml(str) {
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Render cart summary ──────────────────────────────────────────
    function renderSummary() {
        var cart = getCart();
        var empty = document.getElementById('coEmpty');
        var items = document.getElementById('coItems');
        var btn   = document.getElementById('btnConfirm');

        if (!cart.length) {
            empty.style.display = 'block';
            items.style.display = 'none';
            if (btn) btn.disabled = true;
            return;
        }

        empty.style.display = 'none';
        items.style.display = 'block';
        if (btn) btn.disabled = false;

        var subtotal = cart.reduce(function (s, i) { return s + (i.price * i.qty); }, 0);

        var html = cart.map(function (item) {
            var lineTotal = item.price * item.qty;
            var imgEl = item.image
                ? '<img class="co-item-img" src="' + escHtml(item.image) + '" alt="' + escHtml(item.name) + '" onerror="this.style.display=\'none\'">'
                : '<div class="co-item-img d-flex align-items-center justify-content-center" style="font-size:10px;color:#ccc">Sem img</div>';
            return '<div class="co-item">'
                + imgEl
                + '<div style="flex:1;min-width:0;">'
                    + '<div class="co-item-name">' + escHtml(item.name) + '</div>'
                    + '<div class="co-item-qty">Qtd: ' + item.qty + '</div>'
                + '</div>'
                + '<div class="co-item-price">' + formatPrice(lineTotal) + '</div>'
                + '</div>';
        }).join('');

        document.getElementById('coItemsList').innerHTML = html;
        document.getElementById('coSubtotal').textContent = formatPrice(subtotal);
        document.getElementById('coTotal').textContent = formatPrice(subtotal);
    }

    // ── Pre-fill form ────────────────────────────────────────────────
    function prefillFromServer() {
        // Server-side data from JWT (name + email)
        <% if (currentCustomer) { %>
        setVal('co_name',  '<%- (currentCustomer.name  || '').replace(/'/g, "\\'") %>');
        setVal('co_email', '<%- (currentCustomer.email || '').replace(/'/g, "\\'") %>');
        <% } %>
    }

    function setVal(id, val) {
        var el = document.getElementById(id);
        if (el && val) el.value = val;
    }

    function prefillFromApi() {
        fetch('/api/customers/me', { credentials: 'include' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                if (!data || !data.customer) return;
                var c = data.customer;
                setVal('co_name',  c.name);
                setVal('co_email', c.email);
                setVal('co_phone', c.phone);
            })
            .catch(function () {});
    }

    // ── Validation ───────────────────────────────────────────────────
    function showErr(id, show) {
        var el = document.getElementById('err_' + id);
        var input = document.getElementById('co_' + id);
        if (!el || !input) return;
        el.classList.toggle('show', show);
        input.classList.toggle('is-invalid', show);
    }

    function validate() {
        var ok = true;
        var name    = (document.getElementById('co_name').value   || '').trim();
        var email   = (document.getElementById('co_email').value  || '').trim();
        var phone   = (document.getElementById('co_phone').value  || '').trim();
        var prov    = (document.getElementById('co_province').value || '').trim();
        var city    = (document.getElementById('co_city').value   || '').trim();
        var address = (document.getElementById('co_address').value || '').trim();

        if (!name)    { showErr('name',     true); ok = false; } else showErr('name',     false);
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('email', true); ok = false; } else showErr('email', false);
        if (!phone)   { showErr('phone',    true); ok = false; } else showErr('phone',    false);
        if (!prov)    { showErr('province', true); ok = false; } else showErr('province', false);
        if (!city)    { showErr('city',     true); ok = false; } else showErr('city',     false);
        if (!address) { showErr('address',  true); ok = false; } else showErr('address',  false);

        return ok;
    }

    // ── Submit ───────────────────────────────────────────────────────
    function handleSubmit(e) {
        e.preventDefault();
        if (!validate()) {
            document.querySelector('.is-invalid').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        var cart = getCart();
        if (!cart.length) return;

        var btn = document.getElementById('btnConfirm');
        btn.disabled = true;
        btn.innerHTML = '<span class="co-spinner"></span> A processar...';

        var payload = {
            customer: {
                name:    document.getElementById('co_name').value.trim(),
                email:   document.getElementById('co_email').value.trim(),
                phone:   document.getElementById('co_phone').value.trim(),
            },
            delivery: {
                province: document.getElementById('co_province').value.trim(),
                city:     document.getElementById('co_city').value.trim(),
                address:  document.getElementById('co_address').value.trim(),
                notes:    document.getElementById('co_notes').value.trim(),
            },
            items: cart.map(function (i) {
                return { productId: i.id, name: i.name, qty: i.qty, price: i.price, priceFormatted: i.priceFormatted || '', image: i.image || '' };
            }),
        };

        fetch('/api/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(payload),
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
            if (res.ok && res.data.code) {
                localStorage.removeItem(CART_KEY);
                window.location.href = '/encomenda/' + res.data.code;
            } else {
                btn.disabled = false;
                btn.innerHTML = 'Confirmar encomenda &rarr;';
                window.ui.toast(res.data.message || 'Erro ao processar encomenda. Tente novamente.', { type: 'error' });
            }
        })
        .catch(function () {
            btn.disabled = false;
            btn.innerHTML = 'Confirmar encomenda &rarr;';
            window.ui.toast('Erro de ligação. Verifique a sua internet e tente novamente.', { type: 'error' });
        });
    }

    // ── Init ─────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        renderSummary();
        prefillFromServer();
        prefillFromApi();

        var form = document.getElementById('checkoutForm');
        if (form) form.addEventListener('submit', handleSubmit);

        // Real-time clear errors on input
        ['co_name','co_email','co_phone','co_province','co_city','co_address'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('input', function () {
                el.classList.remove('is-invalid');
                var fieldName = id.replace('co_', '');
                var err = document.getElementById('err_' + fieldName);
                if (err) err.classList.remove('show');
            });
        });
    });

})();
</script>

</body>
</html>
